---
import { Icon } from "astro-icon/components";

import stats from "../data/stats";
import desires from "../data/desires";
import classes from "../data/classes";

import {
    getAwakeningModifiersForTarget,
    formatAwakeningLevel,
} from "../utils/awakening";

import StyleTag from "./StyleTag.astro";
import { sortTags } from "../data/tags";

interface Props {
    style: any;
}

const { style } = Astro.props;

const base = import.meta.env.BASE_URL;

const actionFocus = style.kit.actionFocus;

const desire = desires[style.desire];
const styleClass = classes[style.class];

/* =========================================================
   Action Focus Awakening Effects
   ========================================================= */

function getActionFocusAwakening(target: string) {
    return getAwakeningModifiersForTarget(
        style.kit.awakening,
        "actionFocusModifier",
        target,
    )[0];
}

const focusItems = ["intel", "supplies", "execution", "strategy"];
---

<section class="style-header">
    <div class="style-header-inner">
        <!-- ==================================================
             Art
             ================================================== -->

        <div class="style-art-column">
            <div class="style-art-frame">
                <img
                    class="style-art"
                    src={`${base}assets/styles/${style.id}.png`}
                    alt={`${style.characterName} ${style.styleName}`}
                />
            </div>
        </div>

        <!-- ==================================================
             Identity
             ================================================== -->

        <div class="style-identity">
            <div class="style-name-line">
                <strong class="character-name">
                    {style.characterName}
                </strong>

                <span class="style-name">
                    {style.styleName}
                </span>
            </div>

            <div class:list={["rarity", `rarity-${style.rarity}`]}>
                {"★".repeat(style.rarity)}
            </div>

            <div class="style-meta">
                <span class="meta-item">
                    <img
                        src={`${base}assets/icons/${style.desire}.webp`}
                        alt=""
                    />

                    <span>
                        {desire.name}
                    </span>
                </span>

                <span class="meta-item">
                    <img
                        src={`${base}assets/icons/${style.class}.webp`}
                        alt=""
                    />

                    <span>
                        {styleClass.name}
                    </span>
                </span>
            </div>

            <div class="style-tags">
                {
                    sortTags(style.kit.tags).map((tagId) => (
                        <StyleTag id={tagId} />
                    ))
                }
            </div>
        </div>

        <!-- ==================================================
             Overview
             ================================================== -->

        <div class="style-overview">
            <!-- ==================================================
                 Action Focus
                 ================================================== -->

            <div class="action-focus">
                {
                    focusItems.map((focusId) => {
                        const awakeningEffect =
                            getActionFocusAwakening(focusId);

                        return (
                            <div
                                class:list={[
                                    "focus-item",
                                    {
                                        modified: !!awakeningEffect,
                                    },
                                ]}
                            >
                                <span class="focus-name">
                                    {focusId.toUpperCase()}
                                </span>

                                <span class="focus-value">
                                    ✦ {actionFocus[focusId]}
                                </span>

                                {awakeningEffect && (
                                    <div class="focus-tooltip">
                                        <strong>
                                            AWAKENING{" "}
                                            {formatAwakeningLevel(
                                                awakeningEffect.level,
                                            )}
                                        </strong>

                                        <span>
                                            {awakeningEffect.description}
                                        </span>
                                    </div>
                                )}
                            </div>
                        );
                    })
                }
            </div>

            <!-- ==================================================
                 Base Stats
                 ================================================== -->

            <div class="core-stats">
                <div class="stats-heading">LV.100 BASE STATS</div>

                {
                    ["hp", "atk", "def"].map((statId) => {
                        const stat = stats[statId];
                        const value = style.kit.stats[statId];

                        return (
                            <div class="stat-row">
                                <span class="stat-name">
                                    <Icon name={stat.icon} size="20" />

                                    {stat.name}
                                </span>

                                <strong>{value.toLocaleString()}</strong>
                            </div>
                        );
                    })
                }
            </div>
        </div>
    </div>
</section>
