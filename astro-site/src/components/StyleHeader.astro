---
import { Icon } from "astro-icon/components";

import stats from "../data/stats";
import desires from "../data/desires";
import classes from "../data/classes";

import StyleTag from "./StyleTag.astro";

interface Props {
    style: any;
}

const { style } = Astro.props;

const base = import.meta.env.BASE_URL;

const actionFocus = style.kit.actionFocus;

const desire = desires[style.desire];
const styleClass = classes[style.class];


/* =========================================================
   Action Focus Dupe Effects
   ========================================================= */

const actionFocusDupeEffects = style.kit.dupes.flatMap((dupe: any) =>
    dupe.effects
        .filter(
            (effect: any) =>
                effect.type === "actionFocus",
        )
        .map((effect: any) => ({
            dupe: dupe.dupe,
            target: effect.target,
            amount: effect.amount,
            text: effect.text,
        })),
);

function getActionFocusDupe(target: string) {
    return actionFocusDupeEffects.find(
        (effect: any) =>
            effect.target === target,
    );
}

const focusItems = [
    {
        id: "intel",
        name: "INTEL",
        value: actionFocus.intel,
    },
    {
        id: "supplies",
        name: "SUPPLIES",
        value: actionFocus.supplies,
    },
    {
        id: "execution",
        name: "EXECUTION",
        value: actionFocus.execution,
    },
    {
        id: "strategy",
        name: "STRATEGY",
        value: actionFocus.strategy,
    },
];
---

<section class="style-header">

    <div class="style-header-inner">


        <!-- ==================================================
             Art
             ================================================== -->

        <div class="style-art-column">

            <div class="style-art-frame">

                <img
                    class="style-art"
                    src={`${base}assets/styles/${style.id}.png`}
                    alt={`${style.character} · ${style.style}`}
                />

            </div>

        </div>


        <!-- ==================================================
             Identity
             ================================================== -->

        <div class="style-identity">

            <div class="style-name-line">

                <strong>
                    {style.character}
                </strong>

                <span class="name-separator">
                    ·
                </span>

                <span class="style-name">
                    {style.style}
                </span>

            </div>


            <div class="rarity">
                {"★".repeat(style.rarity)}
            </div>


            <div class="style-meta">

                <span class="meta-item">

                    <img
                        src={`${base}assets/icons/${style.desire}.webp`}
                        alt=""
                    />

                    {desire.name}

                </span>


                <span class="meta-item">

                    <img
                        src={`${base}assets/icons/${style.class}.webp`}
                        alt=""
                    />

                    {styleClass.name}

                </span>

            </div>


            <div class="style-tags">

                {style.kit.tags.map((tagId: any) => (
                    <StyleTag id={tagId} />
                ))}

            </div>

        </div>


        <!-- ==================================================
             Overview
             ================================================== -->

        <div class="style-overview">


            <!-- ==================================================
                 Action Focus
                 ================================================== -->

            <div class="action-focus">

                {focusItems.map((focus) => {
                    const dupeEffect =
                        getActionFocusDupe(focus.id);

                    return (
                        <div
                            class:list={[
                                "focus-item",
                                {
                                    modified: !!dupeEffect,
                                },
                            ]}
                            title={
                                dupeEffect
                                    ? `Dupe ${dupeEffect.dupe}: ${dupeEffect.text}`
                                    : undefined
                            }
                        >

                            <span class="focus-name">
                                {focus.name}
                            </span>

                            <span class="focus-value">
                                ✦ {focus.value}
                            </span>

                        </div>
                    );
                })}

            </div>


            <!-- ==================================================
                 Base Stats
                 ================================================== -->

            <div class="core-stats">

                <div class="stats-heading">
                    LV.100 BASE STATS
                </div>


                {
                    (["hp", "atk", "def"] as const).map((statId) => {
                        const stat = stats[statId];
                        const value = style.kit.stats[statId];

                        return (
                            <div class="stat-row">

                                <span class="stat-name">

                                    <Icon
                                        name={stat.icon}
                                        size="20"
                                    />

                                    {stat.name}

                                </span>

                                <strong>
                                    {value.toLocaleString("en-US")}
                                </strong>

                            </div>
                        );
                    })
                }

            </div>

        </div>

    </div>

</section>