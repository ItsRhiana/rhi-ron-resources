---
import EffectText from "./EffectText.astro";
import TeamComposition from "./TeamComposition.astro";
import SpecialSynergies from "./SpecialSynergies.astro";
import SkillCard from "./SkillCard.astro";
import BuildReconstruction from "./BuildReconstruction.astro";

interface Props {
  style: any;
}

const { style } = Astro.props;

const build = style.build;
---

<section class="style-build">
  <!-- =====================================================
         Recommended Build + Reconstruction
         ===================================================== -->

  <div class="build-top-grid">
    <!-- ==================================================
             Recommended Build
             ================================================== -->

    <div class="build-section">
      <div class="section-heading">Level &amp; Position</div>

      <div class="build-summary">
        <div class="build-summary-main">
          <div class="build-header-row">
            <div class="build-level">
              <span class="build-level-prefix"> Lv. </span>

              <span class="build-level-value">
                {build.styleLevel}
              </span>
            </div>

            <div class="build-position">
              <span class="position-primary">
                {build.position.primary}
              </span>

              {
                build.position.secondary && (
                  <>
                    <span class="position-arrow">&gt;</span>

                    <span class="position-secondary">
                      {build.position.secondary}
                    </span>
                  </>
                )
              }
            </div>
          </div>

          <!-- ======================================
                         Skill Levels
                         ====================================== -->

          <div class="build-skill-levels">
            <!-- Basic Attack -->

            <div class="build-skill-level-item">
              <div class="build-skill-level-content">
                <span class="build-skill-level-label"> BASIC ATTACK </span>

                <strong class="build-skill-level-value">
                  Lv.{build.skillLevels.basicAttack}
                </strong>
              </div>

              <div class="build-skill-preview">
                <SkillCard
                  type="basicAttack"
                  skill={style.kit.skills.basicAttack}
                  showModifiers={false}
                  standalone
                />
              </div>
            </div>

            <!-- Passive -->

            <div class="build-skill-level-item">
              <div class="build-skill-level-content">
                <span class="build-skill-level-label"> PASSIVE </span>

                <strong class="build-skill-level-value">
                  Lv.{build.skillLevels.passive}
                </strong>
              </div>

              <div class="build-skill-preview">
                <SkillCard
                  type="passive"
                  skill={style.kit.skills.passive}
                  showModifiers={false}
                  standalone
                />
              </div>
            </div>

            <!-- Ultimate -->

            <div class="build-skill-level-item">
              <div class="build-skill-level-content">
                <span class="build-skill-level-label"> ULTIMATE </span>

                <strong class="build-skill-level-value">
                  Lv.{build.skillLevels.ultimate}
                </strong>
              </div>

              <div class="build-skill-preview">
                <SkillCard
                  type="ultimate"
                  skill={style.kit.skills.ultimate}
                  showModifiers={false}
                  standalone
                />
              </div>
            </div>
          </div>
        </div>

        <!-- ==========================================
                     Explanation
                     ========================================== -->

        <div class="build-summary-note">
          {build.description}
        </div>
      </div>
    </div>

    <!-- ==================================================
             Reconstruction
             ================================================== -->

    <div class="build-section">
      <div class="section-heading">Reconstruction</div>

      <div class="build-reconstruction-panel">
        <BuildReconstruction recommendations={build.reconstruction} />
      </div>
    </div>
  </div>

  <!-- =====================================================
         Generic Team
         ===================================================== -->

  <div class="build-team-section">
    <div class="section-heading">Generic Team</div>

    <TeamComposition team={build.genericTeam} highlightedStyles={[style.id]} />
  </div>

  <!-- =====================================================
     Special Synergies
     ===================================================== -->

  <div class="build-synergy-section">
    <div class="section-heading">Special Synergies</div>

    <div class="special-synergy-warning">
      Special Synergies ≠ Best Teammates
    </div>

    <SpecialSynergies synergies={build.specialSynergies} />

    <div class="special-synergy-team">
      <TeamComposition
        team={build.specialSynergyTeam}
        highlightedStyles={[
          style.id,
          ...build.specialSynergies.flatMap((synergy) => synergy.styles),
        ]}
      />
    </div>
  </div>
</section>
