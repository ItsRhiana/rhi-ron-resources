---
import EffectText from "./EffectText.astro";
import TeamComposition from "./TeamComposition.astro";
import SpecialSynergies from "./SpecialSynergies.astro";
import SkillPanel from "./SkillPanel.astro";
import reconstructionEffects from "../data/reconstruction";

interface Props {
    style: any;
}

const { style } = Astro.props;

const build = style.build;
---

<section class="style-build">
    <!-- =====================================================
         Recommended Build + Reconstruction
         ===================================================== -->

    <div class="build-top-grid">
        <!-- ==================================================
             Recommended Build
             ================================================== -->

        <div class="build-section">
            <div class="section-heading">Level &amp; Position</div>

            <div class="build-summary">
                <div class="build-summary-main">
                    <div class="build-header-row">
                        <div class="build-level">
                            <span class="build-level-prefix"> Lv. </span>

                            <span class="build-level-value">
                                {build.styleLevel}
                            </span>
                        </div>
                        <div class="build-position">
                            <span class="position-primary">
                                {build.position.primary}
                            </span>

                            {
                                build.position.secondary && (
                                    <>
                                        <span class="position-arrow">&gt;</span>

                                        <span class="position-secondary">
                                            {build.position.secondary}
                                        </span>
                                    </>
                                )
                            }
                        </div>
                    </div>

                    <div class="build-skill-levels">
                        <!-- Basic Attack -->

                        <div class="build-skill-level-item">
                            <div class="build-skill-level-content">
                                <span class="build-skill-level-label">
                                    BASIC ATTACK
                                </span>

                                <strong class="build-skill-level-value">
                                    Lv.{build.skillLevels.basicAttack}
                                </strong>
                            </div>

                            <div class="build-skill-preview">
                                <SkillPanel
                                    skills={style.kit.skills}
                                    previewSkill="basicAttack"
                                />
                            </div>
                        </div>

                        <!-- Passive -->

                        <div class="build-skill-level-item">
                            <div class="build-skill-level-content">
                                <span class="build-skill-level-label">
                                    PASSIVE
                                </span>

                                <strong class="build-skill-level-value">
                                    Lv.{build.skillLevels.passive}
                                </strong>
                            </div>

                            <div class="build-skill-preview">
                                <SkillPanel
                                    skills={style.kit.skills}
                                    previewSkill="passive"
                                />
                            </div>
                        </div>

                        <!-- Ultimate -->

                        <div class="build-skill-level-item">
                            <div class="build-skill-level-content">
                                <span class="build-skill-level-label">
                                    ULTIMATE
                                </span>

                                <strong class="build-skill-level-value">
                                    Lv.{build.skillLevels.ultimate}
                                </strong>
                            </div>

                            <div class="build-skill-preview">
                                <SkillPanel
                                    skills={style.kit.skills}
                                    previewSkill="ultimate"
                                />
                            </div>
                        </div>
                    </div>
                </div>

                <div class="build-summary-note">
                    {build.description}
                </div>
            </div>
        </div>

        <!-- ==================================================
             Reconstruction
             ================================================== -->

        <div class="build-section">
            <div class="section-heading">Reconstruction</div>

            <div class="build-reconstruction-list">
                {
                    build.reconstruction.map((item, index) => {
                        const effect = reconstructionEffects[item.effect];

                        return (
                            <div class="build-reconstruction-row">
                                <div class="build-reconstruction-choice">
                                    <div class="build-reconstruction-rank">
                                        <span class="build-reconstruction-symbol">
                                            ϒ
                                        </span>

                                        <span class="build-reconstruction-number">
                                            {index + 1}
                                        </span>
                                    </div>

                                    <div class="build-reconstruction-content">
                                        {item.recommendation && (
                                            <span class="build-reconstruction-recommendation">
                                                {item.recommendation}
                                            </span>
                                        )}

                                        <span
                                            class:list={[
                                                "build-reconstruction-effect",
                                                `skill-reconstruction-${effect.rank.toLowerCase()}`,
                                            ]}
                                            tabindex="0"
                                        >
                                            <span class="reconstruction-skill-label">
                                                <span class="reconstruction-skill-rank">
                                                    {effect.rank}
                                                </span>

                                                <span class="reconstruction-skill-separator">
                                                    ◇
                                                </span>

                                                <span class="reconstruction-skill-name">
                                                    {effect.name}
                                                </span>
                                            </span>

                                            <span class="build-reconstruction-tooltip">
                                                <span
                                                    class:list={[
                                                        "skill-reconstruction-effect",
                                                        `skill-reconstruction-${effect.rank.toLowerCase()}`,
                                                    ]}
                                                >
                                                    <span class="reconstruction-skill-label">
                                                        <span class="reconstruction-skill-rank">
                                                            {effect.rank}
                                                        </span>

                                                        <span class="reconstruction-skill-separator">
                                                            ◇
                                                        </span>

                                                        <span class="reconstruction-skill-name">
                                                            {effect.name}
                                                        </span>
                                                    </span>

                                                    <span>
                                                        <EffectText
                                                            text={
                                                                effect.description
                                                            }
                                                        />
                                                    </span>
                                                </span>
                                            </span>
                                        </span>
                                    </div>
                                </div>

                                <div class="build-reconstruction-note">
                                    {item.note}
                                </div>
                            </div>
                        );
                    })
                }
            </div>
        </div>
    </div>

    <!-- =====================================================
         Generic Team
         ===================================================== -->

    <div class="build-team-section">
        <div class="section-heading">Generic Team</div>

        <TeamComposition
            team={build.genericTeam}
            highlightedStyles={[style.id]}
        />
    </div>

    <!-- =====================================================
         Special Synergies
         ===================================================== -->

    <div class="build-synergy-section">
        <div class="section-heading">Special Synergies</div>

        <div class="special-synergy-warning">
            Special Synergies ≠ Best Teammates
        </div>

        <SpecialSynergies synergies={build.specialSynergies} />

        <!-- ==================================================
             Special Synergy Team
             ================================================== -->

        <div class="special-synergy-team">
            <TeamComposition
                team={build.specialSynergyTeam}
                highlightedStyles={[
                    style.id,
                    ...build.specialSynergies.flatMap(
                        (synergy) => synergy.styles,
                    ),
                ]}
            />
        </div>
    </div>
</section>
