---
import styles from "../data/styles";

interface Props {
  styleIds: string[];
  position: "on-field" | "off-field";
  highlightedStyles?: string[];
}

const { styleIds, position, highlightedStyles } = Astro.props;

const base = import.meta.env.BASE_URL;

function isDimmed(styleId: string) {
  return highlightedStyles && !highlightedStyles.includes(styleId);
}
---

<div
  class:list={[
    "team-style-composite",
    `position-${position}`,
    `count-${styleIds.length}`,
  ]}
>
  {
    styleIds.map((styleId) => {
      const style = styles[styleId];

      const styleUrl = `${base}styles/${style.id}/`;

      const portraitUrl = `${base}assets/styles/${style.id}.png`;

      return (
        <a
          class:list={[
            "team-style-option",
            `rarity-${style.rarity}`,
            {
              dimmed: isDimmed(styleId),
            },
          ]}
          href={styleUrl}
          title={`${style.characterName} — ${style.styleName}`}
        >
          <img
            class="team-style-option-portrait"
            src={portraitUrl}
            alt={`${style.characterName} — ${style.styleName}`}
          />

          <div class="team-style-option-rarity" />
        </a>
      );
    })
  }
</div>

<style>
  /* =====================================================
       Composite Team Style Card
       ===================================================== */

  .team-style-composite {
    width: 156px;

    flex: 0 0 156px;

    display: grid;

    margin: 0;
    padding: 0;

    box-sizing: border-box;

    overflow: hidden;
  }

  /* =====================================================
       Position Shape
       ===================================================== */

  .position-on-field {
    height: 186px;

    border-radius: 78px 78px 0 0;
  }

  .position-off-field {
    height: 130px;

    border-radius: 0;
  }

  /* =====================================================
       Two Styles
       ===================================================== */

  .count-2 {
    grid-template-columns: repeat(2, minmax(0, 1fr));

    grid-template-rows: 1fr;
  }

  /* =====================================================
       Individual Style
       ===================================================== */

  .team-style-option {
    position: relative;

    display: block;

    min-width: 0;
    min-height: 0;

    margin: 0;
    padding: 0;

    overflow: hidden;

    text-decoration: none;

    transition: filter 0.15s ease;
  }

  .team-style-option + .team-style-option {
    border-left: 1px solid var(--color-border-soft);
  }

  /* =====================================================
       Portrait
       ===================================================== */

  .team-style-option-portrait {
    width: 100%;
    height: 100%;

    max-width: none;

    display: block;

    margin: 0;
    padding: 0;

    object-fit: cover;
    object-position: center;

    transition: filter 0.15s ease;
  }

  /* =====================================================
       Individual Hover
       ===================================================== */

  .team-style-option::after {
    content: "";

    position: absolute;

    inset: 0;

    z-index: 3;

    box-sizing: border-box;

    box-shadow: inset 0 0 0 1px var(--color-art-border);

    opacity: 0;

    transition: opacity 0.15s ease;

    pointer-events: none;
  }

  .team-style-option:hover::after {
    opacity: 1;
  }

  .team-style-option:hover .team-style-option-portrait {
    filter: brightness(1.08);
  }

  /* =====================================================
       Rarity
       ===================================================== */

  .team-style-option-rarity {
    position: absolute;

    left: 0;
    right: 0;
    bottom: 0;

    z-index: 2;

    height: 4px;

    margin: 0;
    padding: 0;
  }

  .rarity-6 .team-style-option-rarity {
    background: var(--color-rarity-6);
  }

  .rarity-5 .team-style-option-rarity {
    background: var(--color-rarity-5);
  }

  .rarity-4 .team-style-option-rarity {
    background: var(--color-rarity-4);
  }

  /* =====================================================
       Dimmed
       ===================================================== */

  .dimmed .team-style-option-portrait {
    filter: grayscale(0.8);
  }

  .team-style-option.dimmed:hover .team-style-option-portrait {
    filter: grayscale(0.6) brightness(1.08);
  }
</style>
