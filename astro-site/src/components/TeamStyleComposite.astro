---
import styles from "../data/styles";

interface Props {
  styleIds: string[];
  position: "on-field" | "off-field";
  highlightedStyles?: string[];
}

const { styleIds, position, highlightedStyles } = Astro.props;

const base = import.meta.env.BASE_URL;

function isDimmed(styleId: string) {
  return highlightedStyles && !highlightedStyles.includes(styleId);
}
---

<div class:list={["team-style-composite-wrap", `position-${position}`]}>
  <div class:list={["team-style-composite", `count-${styleIds.length}`]}>
    {
      styleIds.map((styleId) => {
        const style = styles[styleId];

        const styleUrl = `${base}styles/${style.id}/`;

        const portraitUrl = `${base}assets/styles/${style.id}.png`;

        return (
          <a
            class:list={[
              "team-style-option",
              `rarity-${style.rarity}`,
              {
                dimmed: isDimmed(styleId),
              },
            ]}
            href={styleUrl}
            title={`${style.characterName} — ${style.styleName}`}
          >
            <div class="team-style-option-visual">
              <img
                class="team-style-option-portrait"
                src={portraitUrl}
                alt={`${style.characterName} — ${style.styleName}`}
              />

              <div class="team-style-option-rarity" />
            </div>
          </a>
        );
      })
    }
  </div>
</div>

<style>
  /* =====================================================
       Outer Wrapper

       Owns size.
       Allows hover decoration to extend outside.
       ===================================================== */
  .team-style-composite-wrap,
  .team-style-composite,
  .team-style-option,
  .team-style-option-visual,
  .team-style-option-portrait {
    background: transparent !important;

    background-color: transparent !important;
  }

  .team-style-composite-wrap {
    position: relative;

    width: 156px;

    flex: 0 0 156px;

    margin: 0;
    padding: 0;

    overflow: visible;
  }

  .position-on-field {
    height: 186px;
  }

  .position-off-field {
    height: 130px;
  }

  /* =====================================================
       Composite Portrait Grid

       The whole grid owns the position shape.
       ===================================================== */

  .team-style-composite {
    position: relative;

    width: 100%;
    height: 100%;

    display: grid;

    margin: 0;
    padding: 0;

    box-sizing: border-box;

    background: transparent;
  }

  /* =====================================================
       Two Styles

       1 | 2
       ===================================================== */

  .count-2 {
    grid-template-columns: repeat(2, minmax(0, 1fr));

    grid-template-rows: 1fr;
  }

  /* =====================================================
       Three Styles

       1 | 2
       1 | 3
       ===================================================== */

  .count-3 {
    grid-template-columns: repeat(2, minmax(0, 1fr));

    grid-template-rows: repeat(2, minmax(0, 1fr));
  }

  .count-3 .team-style-option:nth-child(1) {
    grid-column: 1;
    grid-row: 1 / 3;
  }

  .count-3 .team-style-option:nth-child(2) {
    grid-column: 2;
    grid-row: 1;
  }

  .count-3 .team-style-option:nth-child(3) {
    grid-column: 2;
    grid-row: 2;
  }

  /* =====================================================
       Four Styles

       1 | 2
       -----
       3 | 4
       ===================================================== */

  .count-4 {
    grid-template-columns: repeat(2, minmax(0, 1fr));

    grid-template-rows: repeat(2, minmax(0, 1fr));
  }

  /* =====================================================
       Individual Style

       IMPORTANT:
       No permanent borders between portraits.
       ===================================================== */

  .team-style-option {
    position: relative;

    z-index: 1;

    display: block;

    width: 100%;
    height: 100%;

    min-width: 0;
    min-height: 0;

    margin: 0;
    padding: 0;

    overflow: visible;

    background: transparent !important;

    text-decoration: none;

    transition:
      transform 0.15s ease,
      filter 0.15s ease;
  }

  .team-style-option-visual {
    position: absolute;

    inset: 0;

    z-index: 1;

    overflow: hidden;

    background: transparent !important;
  }

  .team-style-option-portrait {
    width: 100%;
    height: 100%;

    max-width: none;

    display: block;

    margin: 0;
    padding: 0;

    object-fit: cover;
    object-position: center;

    border: 0;

    transition: filter 0.15s ease;
  }

  /* =====================================================
   2 Styles
   ===================================================== */

  .position-on-field
    .count-2
    .team-style-option:nth-child(1)
    .team-style-option-visual {
    border-radius: 78px 0 0 0;

    overflow: hidden;
  }

  .position-on-field
    .count-2
    .team-style-option:nth-child(2)
    .team-style-option-visual {
    border-radius: 0 78px 0 0;

    overflow: hidden;
  }

  /* =====================================================
   3 Styles
   ===================================================== */

  .position-on-field
    .count-3
    .team-style-option:nth-child(1)
    .team-style-option-visual {
    border-radius: 78px 0 0 0;

    overflow: hidden;
  }

  .position-on-field
    .count-3
    .team-style-option:nth-child(2)
    .team-style-option-visual {
    border-radius: 0 78px 0 0;

    overflow: hidden;
  }

  .position-on-field
    .count-3
    .team-style-option:nth-child(3)
    .team-style-option-visual {
    border-radius: 0;
  }

  /* =====================================================
   4 Styles
   ===================================================== */

  .position-on-field
    .count-4
    .team-style-option:nth-child(1)
    .team-style-option-visual {
    border-radius: 78px 0 0 0;

    overflow: hidden;
  }

  .position-on-field
    .count-4
    .team-style-option:nth-child(2)
    .team-style-option-visual {
    border-radius: 0 78px 0 0;

    overflow: hidden;
  }

  .position-on-field
    .count-4
    .team-style-option:nth-child(3)
    .team-style-option-visual,
  .position-on-field
    .count-4
    .team-style-option:nth-child(4)
    .team-style-option-visual {
    border-radius: 0;
  }

  /* =====================================================
   On-field Shadow Shape

   Shadow must follow the same cut as the portrait.
   ===================================================== */

  /* Top-left */

  .position-on-field .team-style-option:nth-child(1)::before {
    border-radius: 78px 0 0 0;
  }

  /* Top-right */

  .position-on-field .team-style-option:nth-child(2)::before {
    border-radius: 0 78px 0 0;
  }

  /* Lower cells stay rectangular */

  .position-on-field .team-style-option:nth-child(n + 3)::before {
    border-radius: 0;
  }

  /* =====================================================
       Hover Layers

       ::before = shadow
       ::after  = hover border
       ===================================================== */

  .team-style-option::before,
  .team-style-option::after {
    content: "";

    position: absolute;

    left: 0;
    right: 0;
    bottom: 0;

    height: 100%;

    pointer-events: none;
  }

  .team-style-option::before {
    z-index: 0;

    box-sizing: border-box;

    background: transparent;

    opacity: 0;

    box-shadow: 8px 10px 18px 0 rgba(0, 0, 0, 0.9);

    transition:
      opacity 0.15s ease,
      transform 0.15s ease;
  }

  .team-style-option::after {
    z-index: 2;

    box-sizing: border-box;

    border-right: 1px solid var(--color-art-border);

    border-bottom: 1px solid var(--color-art-border);

    opacity: 0;

    transition:
      opacity 0.15s ease,
      transform 0.15s ease;
  }

  /* =====================================================
       Individual Hover
       ===================================================== */
  .team-style-option:hover {
    z-index: 10;

    transform: translateY(-4px);

    filter: brightness(1.08);
  }

  .team-style-option:hover::before {
    opacity: 1;

    transform: translate(2px, 2px);
  }

  .team-style-option:hover::after {
    opacity: 1;

    transform: translate(4px, 4px);
  }

  /* =====================================================
       Upper-right On-field Cell

       It is always item 2.

       Only bottom hover border.
       No right border along the dome edge.
       Shadow only travels downward.
       ===================================================== */

  .position-on-field .team-style-option:nth-child(2)::after {
    border-right: 0;
  }

  .position-on-field .team-style-option:nth-child(2)::before {
    box-shadow: 0 10px 18px 0 rgba(0, 0, 0, 0.9);
  }

  .position-on-field .team-style-option:nth-child(2):hover::before {
    transform: translate(0, 2px);
  }

  .position-on-field .team-style-option:nth-child(2):hover::after {
    transform: translate(0, 4px);
  }

  /* =====================================================
       Rarity
       ===================================================== */

  .team-style-option-rarity {
    position: absolute;

    left: 0;
    right: 0;
    bottom: 0;

    z-index: 3;

    height: 4px;

    margin: 0;
    padding: 0;
  }

  .rarity-6 .team-style-option-rarity {
    background: var(--color-rarity-6);
  }

  .rarity-5 .team-style-option-rarity {
    background: var(--color-rarity-5);
  }

  .rarity-4 .team-style-option-rarity {
    background: var(--color-rarity-4);
  }

  /* =====================================================
       Dimmed
       ===================================================== */

  .dimmed .team-style-option-portrait {
    filter: grayscale(0.8);
  }

  .team-style-option.dimmed:hover .team-style-option-portrait {
    filter: grayscale(0.6);
  }
</style>
