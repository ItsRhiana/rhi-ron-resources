---
import reconstructionEffects, {
    sortReconstruction,
} from "../data/reconstruction";

import ReconstructionEntry from "./ReconstructionEntry.astro";

interface Props {
    reconstruction: any[];
}

const { reconstruction } = Astro.props;
---

<div class="reflection-section">
    <div class="reflection-subheading">
        RECONSTRUCTION
    </div>

    <div class="reconstruction-list">
        {
            sortReconstruction(reconstruction).map((effectId) => {
                const effect =
                    reconstructionEffects[effectId];

                return (
                    <ReconstructionEntry
                        effect={effect}
                    />
                );
            })
        }
    </div>
</div>

<style>
    .reflection-section {
        min-width: 0;

        margin: 0;

        border:
            1px solid var(--color-border);

        background:
            var(--color-panel-bg);
    }

    .reflection-subheading {
        display: flex;

        align-items: center;

        height: 38px;

        margin: 0;

        padding:
            0 16px;

        box-sizing: border-box;

        border-bottom:
            1px solid var(--color-border);

        color:
            var(--color-text-primary);

        font-family:
            var(--font-display);

        font-size: 0.95rem;
        font-weight: 600;

        line-height: 1;

        letter-spacing: 0.02em;
    }

    .reconstruction-list {
        margin: 0;

        padding:
            0 18px;
    }
</style>