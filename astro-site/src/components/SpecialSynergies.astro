---
import styles from "../data/styles";
import reconstructionEffects from "../data/reconstruction";

import EffectText from "./EffectText.astro";
import StyleCard from "./StyleCard.astro";
import SkillCard from "./SkillCard.astro";
import ReconstructionEntry from "./ReconstructionEntry.astro";

interface Props {
    synergies: any[];
}

const { synergies } = Astro.props;
---

<div class="special-synergy-list">

    {
        synergies.map((synergy) => {

            const synergyStyles =
                synergy.styles.map(
                    (styleId) => styles[styleId]
                );

            return (
                <div
                    class:list={[
                        "special-synergy-row",
                        {
                            "special-synergy-row-no-note":
                                !synergy.note,
                        },
                    ]}
                >

                    <!-- =======================================
                         Styles
                         ======================================= -->

                    <div class="special-synergy-style">

                        <div class="special-synergy-style-list">

                            {
                                synergyStyles.map(
                                    (style) => (
                                        <StyleCard
                                            id={style.id}
                                            characterName={
                                                style.characterName
                                            }
                                            styleName={
                                                style.styleName
                                            }
                                            rarity={
                                                style.rarity
                                            }
                                            desire={
                                                style.desire
                                            }
                                        />
                                    )
                                )
                            }

                        </div>

                    </div>


                    <!-- =======================================
                         Effects
                         Temporary rendering
                         ======================================= -->

                    <div class="special-synergy-ability">

{
    synergy.effects?.map(
        (effect) => {

            if (effect.type === "skill") {
                const sourceStyle =
                    styles[effect.source];

                const skill =
                    sourceStyle.kit.skills[
                        effect.skill
                    ];

                return (
                    <div class="special-synergy-effect special-synergy-skill">

                        <SkillCard
                            type={effect.skill}
                            skill={skill}
                            showModifiers={false}
                        />

                    </div>
                );
            }

if (
    effect.type ===
    "reconstruction"
) {
    const reconstructionEffect =
        reconstructionEffects[
            effect.effect
        ];

    return (
        <div class="special-synergy-effect special-synergy-reconstruction">

            <div class="reconstruction-list">

                <ReconstructionEntry
                    effect={reconstructionEffect}
                />

            </div>

        </div>
    );
}

            return null;
        }
    )
}

                    </div>


                    <!-- =======================================
                         Analysis
                         ======================================= -->

                    {
                        synergy.note && (
                            <div class="special-synergy-note">
                                <EffectText
                                    text={synergy.note}
                                />
                            </div>
                        )
                    }

                </div>
            );
        })
    }

</div>