---
import {
    formatAwakeningLevel,
} from "../utils/awakening";

interface Props {
    awakening: Array<{
        level: number;
        effects: Array<{
            description: string;
        }>;
    }>;
}

const { awakening } = Astro.props;
---

<aside class="kit-awakening">

    <div class="section-heading">
        Awakening
    </div>

    <div class="awakening-list">

        {awakening.map((awakeningLevel) => (
            <div class="awakening-row">

                <div class="awakening-level">
                    {formatAwakeningLevel(awakeningLevel.level)}
                </div>

                <div class="awakening-effects">

                    {awakeningLevel.effects.map((effect) => (
                        <div class="awakening-effect">
                            {effect.description}
                        </div>
                    ))}

                </div>

            </div>
        ))}

    </div>

</aside>