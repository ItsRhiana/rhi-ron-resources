---
interface Props {
    id: string;
    characterName: string;
    styleName: string;
    rarity: any;
    desire: string;
    position: "on-field" | "off-field";
    dimmed?: boolean;
}

const {
    id,
    characterName,
    styleName,
    rarity,
    desire,
    position,
    dimmed = false,
} = Astro.props;

const base = import.meta.env.BASE_URL;

const styleUrl = `${base}styles/${id}/`;

const portraitUrl = `${base}assets/styles/${id}.png`;

const desireUrl = `${base}assets/icons/${desire}.webp`;
---

<a
    class="team-style-card-wrap"
    href={styleUrl}
    title={`${characterName} — ${styleName}`}
>
<div
    class:list={[
        "team-style-card",
        `rarity-${rarity}`,
        `position-${position}`,
        {
            dimmed,
        },
    ]}
>
        <img
            class="style-portrait"
            src={portraitUrl}
            alt={`${characterName} — ${styleName}`}
        />

        <div class="desire-badge">
            <img
                src={desireUrl}
                alt={desire}
            />
        </div>

        <div class="style-card-name">
            {characterName}
        </div>

        <div class="rarity-bar"></div>
    </div>
</a>

<style>
    /* =====================================================
       Team Style Card

       Same presentation as StyleCard.
       Only shape + Desire position differ.
       ===================================================== */

    .team-style-card {
        position: relative;

        width: 156px;
        flex: 0 0 156px;

        display: grid;

        grid-template-columns: 1fr;
        grid-template-rows: 1fr;

        box-sizing: border-box;

        padding: 0;
        margin: 0;

        overflow: visible;

        border: 0;

        line-height: normal;

        text-decoration: none;

        transition:
            transform 0.15s ease,
            filter 0.15s ease;
    }

    /* =====================================================
       Shape
       ===================================================== */

    .position-on-field {
        height: 186px;

        border-radius: 78px 78px 0 0;
    }

    .position-off-field {
        height: 130px;

        border-radius: 0;
    }

    /* =====================================================
       Hover Line
       Exact StyleCard behavior
       ===================================================== */

.team-style-card::after {
    content: "";

    position: absolute;

    left: 0;
    right: 0;
    bottom: 0;

    z-index: -1;

    box-sizing: border-box;

    border-right:
        1px solid var(--color-art-border);

    border-bottom:
        1px solid var(--color-art-border);

    opacity: 0;

    transform:
        translate(0, 0);

    transition:
        opacity 0.15s ease,
        transform 0.15s ease;

    pointer-events: none;
}

.position-on-field::after {
    height: 120px;

    border-radius: 0;
}

.position-off-field::after {
    height: 100%;
}

    /* =====================================================
       Shared Layers
       Exact StyleCard structure
       ===================================================== */

    .style-portrait,
    .desire-badge,
    .style-card-name,
    .rarity-bar {
        grid-column: 1;
        grid-row: 1;
    }

    /* =====================================================
       Portrait
       Exact StyleCard presentation
       ===================================================== */

    .style-portrait {
        width: 100%;
        height: 100%;

        max-width: none;

        align-self: stretch;
        justify-self: stretch;

        display: block;

        margin: 0;
        padding: 0;

        object-fit: cover;
        object-position: center;
    }

    .position-on-field .style-portrait {
        border-radius: 78px 78px 0 0;
    }

    .position-off-field .style-portrait {
        border-radius: 0;
    }

    /* =====================================================
       Desire

       Same StyleCard badge dimensions/crop.
       ONLY position is changed.
       ===================================================== */

    .desire-badge {
        width: 25px;
        height: 25px;

        align-self: end;
        justify-self: start;

        z-index: 3;

        overflow: hidden;

        margin: 0 0 30px 0;

        padding: 0;

        background: var(--color-style-card-desire-bg);
    }

    .desire-badge img {
        width: 33px;
        height: 33px;

        max-width: none;

        display: block;

        margin: -4px;
        padding: 0;

        object-fit: contain;
    }

    /* =====================================================
       Name
       COPIED from StyleCard
       ===================================================== */

    .style-card-name {
        align-self: end;
        justify-self: stretch;

        z-index: 2;

        margin: 0;

        padding: 24px 6px 7px;

        box-sizing: border-box;

        color: var(--color-text-primary);

        background: linear-gradient(
            to top,
            color-mix(in srgb, var(--color-overlay-bg) 98%, transparent) 0%,
            color-mix(in srgb, var(--color-overlay-bg) 82%, transparent) 36%,
            transparent 100%
        );

        font-family: var(--font-display);

        font-size: 0.84rem;
        font-weight: 700;

        line-height: 1.1;

        text-align: center;

        white-space: nowrap;
        overflow: hidden;

        text-transform: uppercase;

        pointer-events: none;
    }

    /* =====================================================
       Rarity
       COPIED from StyleCard
       ===================================================== */

    .rarity-bar {
        width: 100%;
        height: 4px;

        align-self: end;
        justify-self: stretch;

        z-index: 4;

        margin: 0;
        padding: 0;
    }

    .rarity-6 .rarity-bar {
        background: var(--color-rarity-6);
    }

    .rarity-5 .rarity-bar {
        background: var(--color-rarity-5);
    }

    .rarity-4 .rarity-bar {
        background: var(--color-rarity-4);
    }

    /* =====================================================
       Dimmed filler
       ===================================================== */

.dimmed {
    filter:
        grayscale(0.8);

    transition:
        transform 0.15s ease,
        filter 0.15s ease;
}

.team-style-card-wrap:hover
.team-style-card.dimmed {
    transform:
        translateY(-2px);

    filter:
        grayscale(0.6)
        brightness(1.08);
}

.team-style-card-wrap {
    display: block;

    width: 156px;

    flex:
        0 0 156px;

    margin: 0;
    padding: 0;

    text-decoration: none;
}

.team-style-card-wrap:has(.position-on-field) {
    height: 186px;
}

.team-style-card-wrap:has(.position-off-field) {
    height: 130px;
}

.team-style-card-wrap:hover
.team-style-card {
    transform:
        translateY(-2px);

    filter:
        brightness(1.08);
}

.team-style-card-wrap:hover
.team-style-card::after {
    opacity: 1;

    transform:
        translate(4px, 4px);
}
</style>
