---
interface Props {
  id: string;
  characterName: string;
  styleName: string;
  rarity: 4 | 5 | 6;
  desire: string;
}

const {
  id,
  characterName,
  styleName,
  rarity,
  desire,
} = Astro.props;

const base = import.meta.env.BASE_URL;

const styleUrl = `${base}styles/${id}/`;
const portraitUrl = `${base}assets/styles/${id}.png`;
const desireUrl = `${base}assets/icons/${desire}.webp`;
---

<a
  class={`style-card rarity-${rarity}`}
  href={styleUrl}
  title={`${characterName} — ${styleName}`}
>
  <img
    class="style-portrait"
    src={portraitUrl}
    alt={`${characterName} — ${styleName}`}
  />

  <div class="desire-badge">
    <img
      src={desireUrl}
      alt={desire}
    />
  </div>

  <div class="style-card-name">
    {characterName}
  </div>

  <div class="rarity-bar"></div>
</a>


<style>
  /* =====================================================
     Style card
     ===================================================== */

  .style-card {
    position: relative;

    width: 125px;
    height: 125px;

    flex: 0 0 125px;

    display: grid;

    grid-template-columns: 1fr;
    grid-template-rows: 1fr;

    box-sizing: border-box;

    padding: 0;
    margin: 0;

    overflow: visible;

    border: 0;

    line-height: normal;

    text-decoration: none;

    transition:
      transform 0.15s ease,
      filter 0.15s ease;
  }


  /* =====================================================
     Hover line
     ===================================================== */

  .style-card::after {
    content: "";

    position: absolute;

    inset: 0;

    z-index: -1;

    box-sizing: border-box;

    border-right: 1px solid var(--color-art-border);
    border-bottom: 1px solid var(--color-art-border);

    opacity: 0;

    transform: translate(0, 0);

    transition:
      opacity 0.15s ease,
      transform 0.15s ease;

    pointer-events: none;
  }

  .style-card:hover {
    transform: translateY(-2px);

    filter: brightness(1.08);
  }

  .style-card:hover::after {
    opacity: 1;

    transform: translate(4px, 4px);
  }


  /* =====================================================
     Shared card layers
     ===================================================== */

  .style-portrait,
  .desire-badge,
  .style-card-name,
  .rarity-bar {
    grid-column: 1;
    grid-row: 1;
  }


  /* =====================================================
     Portrait
     ===================================================== */

  .style-portrait {
    width: 100%;
    height: 100%;

    max-width: none;

    align-self: stretch;
    justify-self: stretch;

    display: block;

    margin: 0;
    padding: 0;

    object-fit: cover;
    object-position: center;
  }


  /* =====================================================
     Desire
     ===================================================== */

  .desire-badge {
    width: 25px;
    height: 25px;

    align-self: start;
    justify-self: start;

    z-index: 3;

    overflow: hidden;

    margin: 0;
    padding: 0;

    background: var(--color-style-card-desire-bg);
  }

.desire-badge img {
  width: 33px;
  height: 33px;

  max-width: none;

  display: block;

  margin: -4px;
  padding: 0;

  object-fit: contain;
}


  /* =====================================================
     Name
     ===================================================== */

.style-card-name {
  align-self: end;
  justify-self: stretch;

  z-index: 2;

  margin: 0;
  padding:
    24px
    6px
    7px;

  box-sizing: border-box;

  color: var(--color-text-primary);

  background:
    linear-gradient(
      to top,
      rgba(0, 0, 0, 0.98) 0%,
      rgba(0, 0, 0, 0.82) 36%,
      rgba(0, 0, 0, 0) 100%
    );

  font-family: var(--font-display);

  font-size: 0.84rem;
  font-weight: 700;

  line-height: 1.1;

  text-align: center;

  text-transform: uppercase;

  pointer-events: none;
}


  /* =====================================================
     Rarity
     ===================================================== */

  .rarity-bar {
    width: 100%;
    height: 4px;

    align-self: end;
    justify-self: stretch;

    z-index: 4;

    margin: 0;
    padding: 0;
  }

  .rarity-6 .rarity-bar {
    background: var(--color-rarity-6);
  }

  .rarity-5 .rarity-bar {
    background: var(--color-rarity-5);
  }

  .rarity-4 .rarity-bar {
    background: var(--color-rarity-4);
  }
</style>