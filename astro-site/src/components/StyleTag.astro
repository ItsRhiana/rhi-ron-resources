---
import { tags, tagTypes } from "../data/tags";

interface Props {
    id: any;
}
const { id } = Astro.props;

const tag = tags[id];
const color = tagTypes[tag.type].color;
---

<span
    class="style-tag"
    style={`--tag-color: ${color}`}
>
    {tag.name}
</span>

<style>
.style-tag {
    display: inline-flex;

    align-items: center;

    margin: 0;

    padding: 5px 8px 3px;

    background: var(--tag-color);

    color: var(--color-text-primary);

    font-family: var(--font-display);
    font-size: 0.82rem;
    font-weight: 700;

    line-height: 1;

    text-transform: uppercase;
}
</style>