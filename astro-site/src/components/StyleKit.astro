---
import SkillPanel from "./SkillPanel.astro";
import AwakeningPanel from "./AwakeningPanel.astro";
import ReflectionPanel from "./ReflectionPanel.astro";

interface Props {
    style: any;
}

const { style } = Astro.props;
---

<section class="style-kit">
    <div class="kit-main-grid">
        <SkillPanel skills={style.kit.skills} awakening={style.kit.awakening} />

        <AwakeningPanel awakening={style.kit.awakening} />

        <ReflectionPanel
            deepening={style.kit.deepening}
            reconstruction={style.kit.reconstruction}
        />
    </div>
</section>
