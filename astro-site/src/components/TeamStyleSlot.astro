---
import styles from "../data/styles";

interface Props {
  styleIds: string[];
  position: "on-field" | "off-field";
  highlightedStyles?: string[];
}

const { styleIds, position, highlightedStyles } = Astro.props;

const base = import.meta.env.BASE_URL;

function isDimmed(styleId: string) {
  return highlightedStyles && !highlightedStyles.includes(styleId);
}

const isComposite = styleIds.length > 1;

const singleStyle = !isComposite ? styles[styleIds[0]] : null;
---

{
  !isComposite && singleStyle ? (
    <a
      class="team-style-slot-link"
      href={`${base}styles/${singleStyle.id}/`}
      title={`${singleStyle.characterName} — ${singleStyle.styleName}`}
    >
      <div
        class:list={[
          "team-style-slot-card",
          `position-${position}`,
          `rarity-${singleStyle.rarity}`,
          {
            dimmed: isDimmed(singleStyle.id),
          },
        ]}
      >
        <img
          class="team-style-slot-portrait"
          src={`${base}assets/styles/${singleStyle.id}.png`}
          alt={`${singleStyle.characterName} — ${singleStyle.styleName}`}
        />

        <div class="team-style-slot-desire">
          <img
            src={`${base}assets/icons/${singleStyle.desire}.webp`}
            alt={singleStyle.desire}
          />
        </div>

        <div class="team-style-slot-name">{singleStyle.characterName}</div>

        <div class="team-style-slot-rarity" />
      </div>
    </a>
  ) : (
    <div class:list={["team-style-composite-wrap", `position-${position}`]}>
      <div class:list={["team-style-composite", `count-${styleIds.length}`]}>
        {styleIds.map((styleId) => {
          const style = styles[styleId];

          return (
            <a
              class:list={[
                "team-style-option",
                `rarity-${style.rarity}`,
                {
                  dimmed: isDimmed(styleId),
                },
              ]}
              href={`${base}styles/${style.id}/`}
              title={`${style.characterName} — ${style.styleName}`}
            >
              <div class="team-style-option-visual">
                <img
                  class="team-style-option-portrait"
                  src={`${base}assets/styles/${style.id}.png`}
                  alt={`${style.characterName} — ${style.styleName}`}
                />

                <div class="team-style-option-rarity" />
              </div>
            </a>
          );
        })}
      </div>
    </div>
  )
}

<style>
  /* =====================================================
     Shared Slot Dimensions
     ===================================================== */

  .team-style-slot-link,
  .team-style-composite-wrap {
    width: 156px;

    flex: 0 0 156px;

    margin: 0;
    padding: 0;
  }

  /* =====================================================
     Single Style — Link
     ===================================================== */

  .team-style-slot-link {
    display: block;

    text-decoration: none;
  }

  /* =====================================================
     Single Style — Card
     ===================================================== */

  .team-style-slot-card {
    position: relative;

    width: 156px;

    display: grid;

    grid-template-columns: 1fr;
    grid-template-rows: 1fr;

    margin: 0;
    padding: 0;

    box-sizing: border-box;

    overflow: visible;

    border: 0;

    line-height: normal;

    transition:
      transform 0.15s ease,
      filter 0.15s ease;
  }

  /* =====================================================
     Position Sizes
     ===================================================== */

  .team-style-slot-card.position-on-field,
  .team-style-composite-wrap.position-on-field {
    height: 186px;
  }

  .team-style-slot-card.position-off-field,
  .team-style-composite-wrap.position-off-field {
    height: 130px;
  }

  /* =====================================================
     Single Style — Hover Border
     ===================================================== */

  .team-style-slot-card::after {
    content: "";

    position: absolute;

    left: 0;
    right: 0;
    bottom: 0;

    z-index: -1;

    box-sizing: border-box;

    border-right: 1px solid var(--color-art-border);

    border-bottom: 1px solid var(--color-art-border);

    opacity: 0;

    transform: translate(0, 0);

    transition:
      opacity 0.15s ease,
      transform 0.15s ease;

    pointer-events: none;
  }

  .team-style-slot-card.position-on-field::after {
    height: 120px;
  }

  .team-style-slot-card.position-off-field::after {
    height: 100%;
  }

  /* =====================================================
     Single Style — Shared Layers
     ===================================================== */

  .team-style-slot-portrait,
  .team-style-slot-desire,
  .team-style-slot-name,
  .team-style-slot-rarity {
    grid-column: 1;
    grid-row: 1;
  }

  /* =====================================================
     Single Style — Portrait
     ===================================================== */

  .team-style-slot-portrait {
    width: 100%;
    height: 100%;

    max-width: none;

    align-self: stretch;
    justify-self: stretch;

    display: block;

    margin: 0;
    padding: 0;

    object-fit: cover;
    object-position: center;
  }

  .team-style-slot-card.position-on-field .team-style-slot-portrait {
    border-radius: 78px 78px 0 0;
  }

  .team-style-slot-card.position-off-field .team-style-slot-portrait {
    border-radius: 0;
  }

  /* =====================================================
     Single Style — Desire
     ===================================================== */

  .team-style-slot-desire {
    width: 25px;
    height: 25px;

    align-self: end;
    justify-self: start;

    z-index: 3;

    overflow: hidden;

    margin: 0 0 30px 0;

    padding: 0;

    background: var(--color-style-card-desire-bg);
  }

  .team-style-slot-desire img {
    width: 33px;
    height: 33px;

    max-width: none;

    display: block;

    margin: -4px;
    padding: 0;

    object-fit: contain;
  }

  /* =====================================================
     Single Style — Name
     ===================================================== */

  .team-style-slot-name {
    align-self: end;
    justify-self: stretch;

    z-index: 2;

    margin: 0;

    padding: 24px 6px 7px;

    box-sizing: border-box;

    color: var(--color-text-primary);

    background: linear-gradient(
      to top,
      color-mix(in srgb, var(--color-overlay-bg) 98%, transparent) 0%,
      color-mix(in srgb, var(--color-overlay-bg) 82%, transparent) 36%,
      transparent 100%
    );

    font-family: var(--font-display);

    font-size: 0.84rem;
    font-weight: 700;

    line-height: 1.1;

    text-align: center;

    white-space: nowrap;
    overflow: hidden;

    text-transform: uppercase;

    pointer-events: none;
  }

  /* =====================================================
     Single Style — Rarity
     ===================================================== */

  .team-style-slot-rarity {
    width: 100%;
    height: 4px;

    align-self: end;
    justify-self: stretch;

    z-index: 4;

    margin: 0;
    padding: 0;
  }

  .rarity-6 .team-style-slot-rarity {
    background: var(--color-rarity-6);
  }

  .rarity-5 .team-style-slot-rarity {
    background: var(--color-rarity-5);
  }

  .rarity-4 .team-style-slot-rarity {
    background: var(--color-rarity-4);
  }

  /* =====================================================
     Single Style — Hover
     ===================================================== */

  .team-style-slot-link:hover .team-style-slot-card {
    transform: translateY(-2px);

    filter: brightness(1.08);
  }

  .team-style-slot-link:hover .team-style-slot-card.dimmed {
    filter: grayscale(0.6) brightness(1.08);
  }

  .team-style-slot-link:hover .team-style-slot-card::after {
    opacity: 1;

    transform: translate(4px, 4px);
  }

  /* =====================================================
     Composite — Wrapper
     ===================================================== */

  .team-style-composite-wrap {
    position: relative;

    overflow: visible;

    background: transparent;
  }

  /* =====================================================
     Composite — Grid
     ===================================================== */

  .team-style-composite {
    position: relative;

    display: grid;

    width: 100%;
    height: 100%;

    margin: 0;
    padding: 0;

    box-sizing: border-box;

    overflow: visible;

    background: transparent;
  }

  /* =====================================================
     Composite — 2 Styles

     1 | 2
     ===================================================== */

  .count-2 {
    grid-template-columns: repeat(2, minmax(0, 1fr));

    grid-template-rows: 1fr;
  }

  /* =====================================================
     Composite — 3 Styles

     1 | 2
     1 | 3
     ===================================================== */

  .count-3 {
    grid-template-columns: repeat(2, minmax(0, 1fr));

    grid-template-rows: repeat(2, minmax(0, 1fr));
  }

  .count-3 .team-style-option:nth-child(1) {
    grid-column: 1;
    grid-row: 1 / 3;
  }

  .count-3 .team-style-option:nth-child(2) {
    grid-column: 2;
    grid-row: 1;
  }

  .count-3 .team-style-option:nth-child(3) {
    grid-column: 2;
    grid-row: 2;
  }

  /* =====================================================
     Composite — 4 Styles

     1 | 2
     -----
     3 | 4
     ===================================================== */

  .count-4 {
    grid-template-columns: repeat(2, minmax(0, 1fr));

    grid-template-rows: repeat(2, minmax(0, 1fr));
  }

  /* =====================================================
     Composite — Individual Style
     ===================================================== */

  .team-style-option {
    position: relative;

    z-index: 1;

    display: block;

    width: 100%;
    height: 100%;

    min-width: 0;
    min-height: 0;

    margin: 0;
    padding: 0;

    overflow: visible;

    background: transparent;

    text-decoration: none;

    transition:
      transform 0.15s ease,
      filter 0.15s ease;
  }

  /* =====================================================
     Composite — Visual Layer
     ===================================================== */

  .team-style-option-visual {
    position: absolute;

    inset: 0;

    z-index: 1;

    overflow: hidden;

    background: transparent;
  }

  /* =====================================================
     Composite — Portrait
     ===================================================== */

  .team-style-option-portrait {
    width: 100%;
    height: 100%;

    max-width: none;

    display: block;

    margin: 0;
    padding: 0;

    border: 0;

    object-fit: cover;
    object-position: center;

    transition: filter 0.15s ease;
  }

  /* =====================================================
     Composite — On-field Dome Cuts
     ===================================================== */

  .position-on-field .team-style-option:nth-child(1) .team-style-option-visual {
    border-radius: 78px 0 0 0;
  }

  .position-on-field .team-style-option:nth-child(2) .team-style-option-visual {
    border-radius: 0 78px 0 0;
  }

  .position-on-field
    .team-style-option:nth-child(n + 3)
    .team-style-option-visual {
    border-radius: 0;
  }

  /* =====================================================
     Composite — Hover Layers
     ===================================================== */

  .team-style-option::before,
  .team-style-option::after {
    content: "";

    position: absolute;

    left: 0;
    right: 0;
    bottom: 0;

    height: 100%;

    pointer-events: none;
  }

  /* =====================================================
     Composite — Shadow
     ===================================================== */

  .team-style-option::before {
    z-index: 0;

    box-sizing: border-box;

    background: transparent;

    opacity: 0;

    box-shadow: 8px 10px 18px 0 rgba(0, 0, 0, 0.9);

    transition:
      opacity 0.15s ease,
      transform 0.15s ease;
  }

  /* Shadow follows curved portrait shape */

  .position-on-field .team-style-option:nth-child(1)::before {
    border-radius: 78px 0 0 0;
  }

  .position-on-field .team-style-option:nth-child(2)::before {
    border-radius: 0 78px 0 0;

    box-shadow: 0 10px 18px 0 rgba(0, 0, 0, 0.9);
  }

  .position-on-field .team-style-option:nth-child(n + 3)::before {
    border-radius: 0;
  }

  /* =====================================================
     Composite — Hover Border
     ===================================================== */

  .team-style-option::after {
    z-index: 2;

    box-sizing: border-box;

    border-right: 1px solid var(--color-art-border);

    border-bottom: 1px solid var(--color-art-border);

    opacity: 0;

    transition:
      opacity 0.15s ease,
      transform 0.15s ease;
  }

  /* =====================================================
     Composite — Individual Hover
     ===================================================== */

  .team-style-option:hover {
    z-index: 10;

    transform: translateY(-4px);

    filter: brightness(1.08);
  }

  .team-style-option:hover::before {
    opacity: 1;

    transform: translate(2px, 2px);
  }

  .team-style-option:hover::after {
    opacity: 1;

    transform: translate(4px, 4px);
  }

  /* =====================================================
     Composite — Upper-right Hover
     ===================================================== */

  .position-on-field .team-style-option:nth-child(2)::after {
    border-right: 0;
  }

  .position-on-field .team-style-option:nth-child(2):hover::before {
    transform: translate(0, 2px);
  }

  .position-on-field .team-style-option:nth-child(2):hover::after {
    transform: translate(0, 4px);
  }

  /* =====================================================
     Composite — Rarity
     ===================================================== */

  .team-style-option-rarity {
    position: absolute;

    left: 0;
    right: 0;
    bottom: 0;

    z-index: 3;

    height: 4px;

    margin: 0;
    padding: 0;
  }

  .rarity-6 .team-style-option-rarity {
    background: var(--color-rarity-6);
  }

  .rarity-5 .team-style-option-rarity {
    background: var(--color-rarity-5);
  }

  .rarity-4 .team-style-option-rarity {
    background: var(--color-rarity-4);
  }

  /* =====================================================
     Dimming
     ===================================================== */

  .team-style-slot-card.dimmed {
    filter: grayscale(0.8);
  }

  .team-style-option.dimmed .team-style-option-portrait {
    filter: grayscale(0.8);
  }

  .team-style-option.dimmed:hover .team-style-option-portrait {
    filter: grayscale(0.6);
  }
</style>
