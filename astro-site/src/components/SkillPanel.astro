---
import SkillCard from "./SkillCard.astro";

import reconstructionEffects, {
    sortReconstruction,
} from "../data/reconstruction";

import { getAwakeningModifiersForTarget } from "../utils/awakening";

interface Props {
    skills: any;
    awakening?: any[];
    reconstruction?: any[];
    previewSkill?: "basicAttack" | "passive" | "ultimate";
}

const {
    skills,
    awakening = [],
    reconstruction = [],
    previewSkill,
} = Astro.props;

/* =========================================================
   Preview State
   ========================================================= */

const isPreview = !!previewSkill;

const showBasicAttack = !previewSkill || previewSkill === "basicAttack";

const showPassive = !previewSkill || previewSkill === "passive";

const showUltimate = !previewSkill || previewSkill === "ultimate";

/* =========================================================
   Skill Awakening Effects
   ========================================================= */

const basicAttackAwakeningEffects = getAwakeningModifiersForTarget(
    awakening,
    "skillModifier",
    "basicAttack",
);

const passiveAwakeningEffects = getAwakeningModifiersForTarget(
    awakening,
    "skillModifier",
    "passive",
);

const ultimateAwakeningEffects = getAwakeningModifiersForTarget(
    awakening,
    "skillModifier",
    "ultimate",
);

/* =========================================================
   Skill Reconstruction Effects
   ========================================================= */

function getReconstructionForTarget(target: string) {
    return sortReconstruction(reconstruction)
        .map((effectId) => reconstructionEffects[effectId])
        .filter((effect) => effect.target === target);
}

const basicAttackReconstructionEffects =
    getReconstructionForTarget("basicAttack");

const passiveReconstructionEffects = getReconstructionForTarget("passive");

const ultimateReconstructionEffects = getReconstructionForTarget("ultimate");
---

<div
    class:list={[
        "kit-skills",
        {
            "kit-skills-preview": isPreview,
        },
    ]}
>
    {!isPreview && <div class="section-heading">Lv.10 Skills</div>}

    <div
        class:list={[
            "skills-grid",
            {
                "skills-grid-preview": isPreview,
            },
        ]}
    >
        <!-- ==================================================
             Basic Attack
             ================================================== -->

        {
            showBasicAttack && (
                <SkillCard
                    type="basicAttack"
                    skill={skills.basicAttack}
                    awakeningEffects={basicAttackAwakeningEffects}
                    reconstructionEffects={basicAttackReconstructionEffects}
                    showModifiers={!isPreview}
                />
            )
        }

        <!-- ==================================================
             Passive
             ================================================== -->

        {
            showPassive && (
                <SkillCard
                    type="passive"
                    skill={skills.passive}
                    awakeningEffects={passiveAwakeningEffects}
                    reconstructionEffects={passiveReconstructionEffects}
                    showModifiers={!isPreview}
                />
            )
        }

        <!-- ==================================================
             Ultimate
             ================================================== -->

        {
            showUltimate && (
                <SkillCard
                    type="ultimate"
                    skill={skills.ultimate}
                    awakeningEffects={ultimateAwakeningEffects}
                    reconstructionEffects={ultimateReconstructionEffects}
                    showModifiers={!isPreview}
                />
            )
        }
    </div>
</div>
