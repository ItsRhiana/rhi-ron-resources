---
import StyleTag from "./StyleTag.astro";
import SkillEffect from "./SkillEffect.astro";
import reconstructionEffects from "../data/reconstruction";

import {
    getAwakeningModifiersForTarget,
    formatAwakeningLevel,
} from "../utils/awakening";

interface Props {
    skills: any;
    awakening: any[];
    reconstruction: Array<keyof typeof reconstructionEffects>;
}

const { skills, awakening, reconstruction } = Astro.props;
/* =========================================================
   Skill Awakening Effects
   ========================================================= */

const basicAttackAwakeningEffects = getAwakeningModifiersForTarget(
    awakening,
    "skillModifier",
    "basicAttack",
);

const passiveAwakeningEffects = getAwakeningModifiersForTarget(
    awakening,
    "skillModifier",
    "passive",
);

const ultimateAwakeningEffects = getAwakeningModifiersForTarget(
    awakening,
    "skillModifier",
    "ultimate",
);

const styleReconstructionEffects = reconstruction.map((effectId) => ({
    id: effectId,
    ...reconstructionEffects[effectId],
}));

const basicAttackReconstructionEffects = styleReconstructionEffects.filter(
    (effect) => "target" in effect && effect.target === "basicAttack",
);

const passiveReconstructionEffects = styleReconstructionEffects.filter(
    (effect) => "target" in effect && effect.target === "passive",
);

const ultimateReconstructionEffects = styleReconstructionEffects.filter(
    (effect) => "target" in effect && effect.target === "ultimate",
);
---

<div class="kit-skills">
    <div class="section-heading">Lv.10 Skills</div>

    <div class="skills-grid">
        <!-- ==================================================
             Basic Attack
             ================================================== -->

        <article class="skill-column">
            <div class="skill-title">BASIC ATTACK</div>

            <div class="skill-meta">
                {
                    skills.basicAttack.tags?.length > 0 && (
                        <div class="skill-tags">
                            {skills.basicAttack.tags.map((tagId) => (
                                <StyleTag id={tagId} />
                            ))}
                        </div>
                    )
                }

                <div class="attack-meta">
                    <span>
                        Hit Count

                        <strong>
                            {skills.basicAttack.hitCount}
                        </strong>
                    </span>

                    <span>
                        Speed

                        <strong>
                            {skills.basicAttack.speed}
                        </strong>
                    </span>

                    <span>
                        Range

                        <strong>
                            {skills.basicAttack.range}
                        </strong>
                    </span>
                </div>
            </div>

            <div class="skill-divider"></div>

            <div class="skill-effects">
                {
                    skills.basicAttack.effects.map((effect) => (
                        <SkillEffect effect={effect} />
                    ))
                }
            </div>

            <div class="skill-modifier-slot">
                <div class="skill-modifier-effects">
                    {
                        basicAttackAwakeningEffects.map((effect) => (
                            <div class="skill-awakening-effect">
                                <span class="awakening-label">
                                    AWAKENING{" "}
                                    {formatAwakeningLevel(effect.level)}
                                </span>

                                <span>{effect.description}</span>
                            </div>
                        ))
                    }

                    {
                        basicAttackReconstructionEffects.map((effect) => (
                            <div
                                class:list={[
                                    "skill-reconstruction-effect",
                                    `skill-reconstruction-${effect.rank.toLowerCase()}`,
                                ]}
                            >
                                <span class="reconstruction-skill-label">
                                    <span class="reconstruction-skill-rank">
                                        {effect.rank}
                                    </span>

                                    <span class="reconstruction-skill-separator">
                                        ·
                                    </span>

                                    <span class="reconstruction-skill-name">
                                        {effect.name}
                                    </span>
                                </span>

                                <span>{effect.description}</span>
                            </div>
                        ))
                    }
                </div>
            </div>
        </article>

        <!-- ==================================================
             Passive
             ================================================== -->

        <article class="skill-column">
            <div class="skill-title">PASSIVE</div>

            <div class="skill-meta">
                {
                    skills.passive.tags.length > 0 && (
                        <div class="skill-tags">
                            {skills.passive.tags.map((tagId) => (
                                <StyleTag id={tagId} />
                            ))}
                        </div>
                    )
                }

                <div class="skill-meta-line">
                    <span class="skill-meta-label"> Trigger </span>

                    <span class="skill-meta-value">
                        {skills.passive.trigger}
                    </span>
                </div>
            </div>

            <div class="skill-divider"></div>

            <div class="skill-effects">
                {
                    skills.passive.effects.map((effect) => (
                        <SkillEffect effect={effect} />
                    ))
                }
            </div>

            <div class="skill-modifier-slot">
                <div class="skill-modifier-effects">
                    {
                        passiveAwakeningEffects.map((effect) => (
                            <div class="skill-awakening-effect">
                                <span class="awakening-label">
                                    AWAKENING{" "}
                                    {formatAwakeningLevel(effect.level)}
                                </span>

                                <span>{effect.description}</span>
                            </div>
                        ))
                    }

                    {
                        passiveReconstructionEffects.map((effect) => (
                            <div
                                class:list={[
                                    "skill-reconstruction-effect",
                                    `skill-reconstruction-${effect.rank.toLowerCase()}`,
                                ]}
                            >
                                <span class="reconstruction-skill-label">
                                    <span class="reconstruction-skill-rank">
                                        {effect.rank}
                                    </span>

                                    <span class="reconstruction-skill-separator">
                                        ·
                                    </span>

                                    <span class="reconstruction-skill-name">
                                        {effect.name}
                                    </span>
                                </span>

                                <span>{effect.description}</span>
                            </div>
                        ))
                    }
                </div>
            </div>
        </article>

        <!-- ==================================================
             Ultimate
             ================================================== -->

        <article class="skill-column">
            <div class="skill-title">ULTIMATE</div>

            <div class="skill-meta">
                {
                    skills.ultimate.tags.length > 0 && (
                        <div class="skill-tags">
                            {skills.ultimate.tags.map((tagId) => (
                                <StyleTag id={tagId} />
                            ))}
                        </div>
                    )
                }

                <div class="skill-meta-line">
                    <span class="skill-meta-label"> Flame Cost </span>

                    <span class="skill-meta-value">
                        {skills.ultimate.flameCost}
                    </span>
                </div>
            </div>

            <div class="skill-divider"></div>

            <div class="skill-effects">
                {
                    skills.ultimate.effects.map((effect) => (
                        <SkillEffect effect={effect} />
                    ))
                }
            </div>

            <div class="skill-modifier-slot">
                <div class="skill-modifier-effects">
                    {
                        ultimateAwakeningEffects.map((effect) => (
                            <div class="skill-awakening-effect">
                                <span class="awakening-label">
                                    AWAKENING{" "}
                                    {formatAwakeningLevel(effect.level)}
                                </span>

                                <span>{effect.description}</span>
                            </div>
                        ))
                    }

                    {
                        ultimateReconstructionEffects.map((effect) => (
                            <div
                                class:list={[
                                    "skill-reconstruction-effect",
                                    `skill-reconstruction-${effect.rank.toLowerCase()}`,
                                ]}
                            >
                                <span class="reconstruction-skill-label">
                                    <span class="reconstruction-skill-rank">
                                        {effect.rank}
                                    </span>

                                    <span class="reconstruction-skill-separator">
                                        ·
                                    </span>

                                    <span class="reconstruction-skill-name">
                                        {effect.name}
                                    </span>
                                </span>

                                <span>{effect.description}</span>
                            </div>
                        ))
                    }
                </div>
            </div>
        </article>
    </div>
</div>
