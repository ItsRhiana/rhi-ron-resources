---
import StyleTag from "./StyleTag.astro";
import SkillEffect from "./SkillEffect.astro";

import {
    getAwakeningModifiersForTarget,
    formatAwakeningLevel,
} from "../utils/awakening";

interface Props {
    skills: any;
    awakening: any[];
}

const {
    skills,
    awakening,
} = Astro.props;


/* =========================================================
   Skill Awakening Effects
   ========================================================= */

const basicAttackAwakeningEffects =
    getAwakeningModifiersForTarget(
        awakening,
        "skillModifier",
        "basicAttack",
    );

const passiveAwakeningEffects =
    getAwakeningModifiersForTarget(
        awakening,
        "skillModifier",
        "passive",
    );

const ultimateAwakeningEffects =
    getAwakeningModifiersForTarget(
        awakening,
        "skillModifier",
        "ultimate",
    );
---

<div class="kit-skills">

    <div class="section-heading">
        Lv.10 Skills
    </div>


    <div class="skills-grid">


        <!-- ==================================================
             Basic Attack
             ================================================== -->

        <article class="skill-column">

            <div class="skill-title">
                BASIC ATTACK
            </div>


            <div class="skill-meta">

                <div class="attack-meta">

                    <span>
                        Hit Count

                        <strong>
                            {skills.basicAttack.hitCount}
                        </strong>
                    </span>


                    <span>
                        Speed

                        <strong>
                            {skills.basicAttack.speed}
                        </strong>
                    </span>


                    <span>
                        Range

                        <strong>
                            {skills.basicAttack.range}
                        </strong>
                    </span>

                </div>

            </div>


            <div class="skill-divider"></div>


            <div class="skill-effects">

                {skills.basicAttack.effects.map((effect) => (
                    <SkillEffect effect={effect} />
                ))}

            </div>


            {basicAttackAwakeningEffects.length > 0 && (
                <div class="skill-awakening-effects">

                    {basicAttackAwakeningEffects.map((effect) => (
                        <div class="skill-awakening-effect">

                            <span class="awakening-label">
                                AWAKENING{" "}
                                {formatAwakeningLevel(effect.level)}
                            </span>

                            <span>
                                {effect.description}
                            </span>

                        </div>
                    ))}

                </div>
            )}

        </article>


        <!-- ==================================================
             Passive
             ================================================== -->

        <article class="skill-column">

            <div class="skill-title">
                PASSIVE
            </div>


            <div class="skill-meta">

                {skills.passive.tags.length > 0 && (
                    <div class="skill-tags">

                        {skills.passive.tags.map((tagId) => (
                            <StyleTag id={tagId} />
                        ))}

                    </div>
                )}


                <div class="skill-meta-line">
                    {skills.passive.trigger}
                </div>

            </div>


            <div class="skill-divider"></div>


            <div class="skill-effects">

                {skills.passive.effects.map((effect) => (
                    <SkillEffect effect={effect} />
                ))}

            </div>


            {passiveAwakeningEffects.length > 0 && (
                <div class="skill-awakening-effects">

                    {passiveAwakeningEffects.map((effect) => (
                        <div class="skill-awakening-effect">

                            <span class="awakening-label">
                                AWAKENING{" "}
                                {formatAwakeningLevel(effect.level)}
                            </span>

                            <span>
                                {effect.description}
                            </span>

                        </div>
                    ))}

                </div>
            )}

        </article>


        <!-- ==================================================
             Ultimate
             ================================================== -->

        <article class="skill-column">

            <div class="skill-title">
                ULTIMATE
            </div>


            <div class="skill-meta">

                {skills.ultimate.tags.length > 0 && (
                    <div class="skill-tags">

                        {skills.ultimate.tags.map((tagId) => (
                            <StyleTag id={tagId} />
                        ))}

                    </div>
                )}


                <div class="skill-meta-line">
                    Flame Cost {skills.ultimate.flameCost}
                </div>

            </div>


            <div class="skill-divider"></div>


            <div class="skill-effects">

                {skills.ultimate.effects.map((effect) => (
                    <SkillEffect effect={effect} />
                ))}

            </div>


            {ultimateAwakeningEffects.length > 0 && (
                <div class="skill-awakening-effects">

                    {ultimateAwakeningEffects.map((effect) => (
                        <div class="skill-awakening-effect">

                            <span class="awakening-label">
                                AWAKENING{" "}
                                {formatAwakeningLevel(effect.level)}
                            </span>

                            <span>
                                {effect.description}
                            </span>

                        </div>
                    ))}

                </div>
            )}

        </article>

    </div>

</div>