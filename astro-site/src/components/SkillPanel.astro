---
import StyleTag from "./StyleTag.astro";
import { sortTags } from "../data/tags";
import SkillEffect from "./SkillEffect.astro";
import SkillModifiers from "./SkillModifiers.astro";

import reconstructionEffects, {
    sortReconstruction,
} from "../data/reconstruction";

import {
    getAwakeningModifiersForTarget,
} from "../utils/awakening";

interface Props {
    skills: any;
    awakening?: any[];
    reconstruction?: any[];
    previewSkill?:
        | "basicAttack"
        | "passive"
        | "ultimate";
}

const {
    skills,
    awakening = [],
    reconstruction = [],
    previewSkill,
} = Astro.props;


/* =========================================================
   Preview State
   ========================================================= */

const isPreview =
    !!previewSkill;

const showBasicAttack =
    !previewSkill ||
    previewSkill === "basicAttack";

const showPassive =
    !previewSkill ||
    previewSkill === "passive";

const showUltimate =
    !previewSkill ||
    previewSkill === "ultimate";


/* =========================================================
   Skill Awakening Effects
   ========================================================= */

const basicAttackAwakeningEffects =
    getAwakeningModifiersForTarget(
        awakening,
        "skillModifier",
        "basicAttack",
    );

const passiveAwakeningEffects =
    getAwakeningModifiersForTarget(
        awakening,
        "skillModifier",
        "passive",
    );

const ultimateAwakeningEffects =
    getAwakeningModifiersForTarget(
        awakening,
        "skillModifier",
        "ultimate",
    );


/* =========================================================
   Skill Reconstruction Effects
   ========================================================= */

function getReconstructionForTarget(
    target: string,
) {
    return sortReconstruction(reconstruction)
        .map(
            (effectId) =>
                reconstructionEffects[effectId]
        )
        .filter(
            (effect) =>
                effect.target === target
        );
}

const basicAttackReconstructionEffects =
    getReconstructionForTarget(
        "basicAttack"
    );

const passiveReconstructionEffects =
    getReconstructionForTarget(
        "passive"
    );

const ultimateReconstructionEffects =
    getReconstructionForTarget(
        "ultimate"
    );
---

<div
    class:list={[
        "kit-skills",
        {
            "kit-skills-preview":
                isPreview,
        },
    ]}
>

    {
        !isPreview && (
            <div class="section-heading">
                Lv.10 Skills
            </div>
        )
    }

    <div
        class:list={[
            "skills-grid",
            {
                "skills-grid-preview":
                    isPreview,
            },
        ]}
    >

        <!-- ==================================================
             Basic Attack
             ================================================== -->

        {
            showBasicAttack && (
                <article class="skill-column">

                    <div class="skill-title">
                        BASIC ATTACK
                    </div>

                    <div class="skill-meta">

                        {
                            skills.basicAttack.tags.length > 0 && (
                                <div class="skill-tags">

                                    {
                                        sortTags(
                                            skills.basicAttack.tags
                                        ).map(
                                            (tagId) => (
                                                <StyleTag
                                                    id={tagId}
                                                />
                                            )
                                        )
                                    }

                                </div>
                            )
                        }

                        <div class="attack-meta">

                            <span>
                                Shots

                                <strong>
                                    {
                                        skills
                                            .basicAttack
                                            .shots
                                    }
                                </strong>
                            </span>

                            <span>
                                Speed

                                <strong>
                                    {
                                        skills
                                            .basicAttack
                                            .speed
                                    }
                                </strong>
                            </span>

                            <span>
                                Range

                                <strong>
                                    {
                                        skills
                                            .basicAttack
                                            .range
                                    }
                                </strong>
                            </span>

                        </div>

                    </div>

                    <div class="skill-divider"></div>

                    <div class="skill-effects">

                        {
                            skills.basicAttack.effects.map(
                                (effect) => (
                                    <SkillEffect
                                        effect={effect}
                                    />
                                )
                            )
                        }

                        {
                            !isPreview && (
                                <SkillModifiers
                                    awakeningEffects={
                                        basicAttackAwakeningEffects
                                    }
                                    reconstructionEffects={
                                        basicAttackReconstructionEffects
                                    }
                                />
                            )
                        }

                    </div>

                </article>
            )
        }


        <!-- ==================================================
             Passive
             ================================================== -->

        {
            showPassive && (
                <article class="skill-column">

                    <div class="skill-title">
                        PASSIVE
                    </div>

                    <div class="skill-meta">

                        {
                            skills.passive.tags.length > 0 && (
                                <div class="skill-tags">

                                    {
                                        sortTags(
                                            skills.passive.tags
                                        ).map(
                                            (tagId) => (
                                                <StyleTag
                                                    id={tagId}
                                                />
                                            )
                                        )
                                    }

                                </div>
                            )
                        }

                        {
                            skills.passive.trigger && (
                                <div class="skill-meta-line">

                                    <span class="skill-meta-label">
                                        Trigger
                                    </span>

                                    <span class="skill-meta-value">
                                        {
                                            skills
                                                .passive
                                                .trigger
                                        }
                                    </span>

                                </div>
                            )
                        }

                    </div>

                    <div class="skill-divider"></div>

                    <div class="skill-effects">

                        {
                            skills.passive.effects.map(
                                (effect) => (
                                    <SkillEffect
                                        effect={effect}
                                    />
                                )
                            )
                        }

                        {
                            !isPreview && (
                                <SkillModifiers
                                    awakeningEffects={
                                        passiveAwakeningEffects
                                    }
                                    reconstructionEffects={
                                        passiveReconstructionEffects
                                    }
                                />
                            )
                        }

                    </div>

                </article>
            )
        }


        <!-- ==================================================
             Ultimate
             ================================================== -->

        {
            showUltimate && (
                <article class="skill-column">

                    <div class="skill-title">
                        ULTIMATE
                    </div>

                    <div class="skill-meta">

                        {
                            skills.ultimate.tags.length > 0 && (
                                <div class="skill-tags">

                                    {
                                        sortTags(
                                            skills.ultimate.tags
                                        ).map(
                                            (tagId) => (
                                                <StyleTag
                                                    id={tagId}
                                                />
                                            )
                                        )
                                    }

                                </div>
                            )
                        }

                        <div class="skill-meta-line">

                            <span class="skill-meta-label">
                                Flame Cost
                            </span>

                            <span class="skill-meta-value">
                                {
                                    skills
                                        .ultimate
                                        .flameCost
                                }
                            </span>

                        </div>

                    </div>

                    <div class="skill-divider"></div>

                    <div class="skill-effects">

                        {
                            skills.ultimate.effects.map(
                                (effect) => (
                                    <SkillEffect
                                        effect={effect}
                                    />
                                )
                            )
                        }

                        {
                            !isPreview && (
                                <SkillModifiers
                                    awakeningEffects={
                                        ultimateAwakeningEffects
                                    }
                                    reconstructionEffects={
                                        ultimateReconstructionEffects
                                    }
                                />
                            )
                        }

                    </div>

                </article>
            )
        }

    </div>

</div>