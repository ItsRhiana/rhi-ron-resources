---
import StyleTag from "./StyleTag.astro";
import { sortTags } from "../data/tags";
import SkillEffect from "./SkillEffect.astro";
import SkillModifiers from "./SkillModifiers.astro";

import reconstructionEffects from "../data/reconstruction";
import reconstructionEffects, {
    sortReconstruction,
} from "../data/reconstruction";

import { getAwakeningModifiersForTarget } from "../utils/awakening";

interface Props {
    skills: any;
    awakening: any[];
    reconstruction: any[];
}

const { skills, awakening, reconstruction } = Astro.props;

/* =========================================================
   Skill Awakening Effects
   ========================================================= */

const basicAttackAwakeningEffects = getAwakeningModifiersForTarget(
    awakening,
    "skillModifier",
    "basicAttack",
);

const passiveAwakeningEffects = getAwakeningModifiersForTarget(
    awakening,
    "skillModifier",
    "passive",
);

const ultimateAwakeningEffects = getAwakeningModifiersForTarget(
    awakening,
    "skillModifier",
    "ultimate",
);

/* =========================================================
   Skill Reconstruction Effects
   ========================================================= */

function getReconstructionForTarget(target: string) {
    return sortReconstruction(reconstruction)
        .map((effectId) => reconstructionEffects[effectId])
        .filter((effect) => effect.target === target);
}

const basicAttackReconstructionEffects =
    getReconstructionForTarget("basicAttack");

const passiveReconstructionEffects = getReconstructionForTarget("passive");

const ultimateReconstructionEffects = getReconstructionForTarget("ultimate");
---

<div class="kit-skills">
    <div class="section-heading">Lv.10 Skills</div>

    <div class="skills-grid">
        <!-- ==================================================
             Basic Attack
             ================================================== -->

        <article class="skill-column">
            <div class="skill-title">BASIC ATTACK</div>

            <div class="skill-meta">
                {
                    skills.basicAttack.tags.length > 0 && (
                        <div class="skill-tags">
                            {skills.basicAttack.tags.map((tagId) => (
                                <StyleTag id={tagId} />
                            ))}
                        </div>
                    )
                }

                <div class="attack-meta">
                    <span>
                        Shots

                        <strong>
                            {skills.basicAttack.shots}
                        </strong>
                    </span>

                    <span>
                        Speed

                        <strong>
                            {skills.basicAttack.speed}
                        </strong>
                    </span>

                    <span>
                        Range

                        <strong>
                            {skills.basicAttack.range}
                        </strong>
                    </span>
                </div>
            </div>

            <div class="skill-divider"></div>

            <div class="skill-effects">
                {
                    skills.basicAttack.effects.map((effect) => (
                        <SkillEffect effect={effect} />
                    ))
                }
            </div>

            <SkillModifiers
                awakeningEffects={basicAttackAwakeningEffects}
                reconstructionEffects={basicAttackReconstructionEffects}
            />
        </article>

        <!-- ==================================================
             Passive
             ================================================== -->

        <article class="skill-column">
            <div class="skill-title">PASSIVE</div>

            <div class="skill-meta">
                {
                    skills.passive.tags.length > 0 && (
                        <div class="skill-tags">
                            {sortTags(skills.passive.tags).map((tagId) => (
                                <StyleTag id={tagId} />
                            ))}
                        </div>
                    )
                }

                {
                    skills.passive.trigger && (
                        <div class="skill-meta-line">
                            <span class="skill-meta-label">Trigger</span>

                            <span class="skill-meta-value">
                                {skills.passive.trigger}
                            </span>
                        </div>
                    )
                }
            </div>

            <div class="skill-divider"></div>

            <div class="skill-effects">
                {
                    skills.passive.effects.map((effect) => (
                        <SkillEffect effect={effect} />
                    ))
                }
            </div>

            <SkillModifiers
                awakeningEffects={passiveAwakeningEffects}
                reconstructionEffects={passiveReconstructionEffects}
            />
        </article>

        <!-- ==================================================
             Ultimate
             ================================================== -->

        <article class="skill-column">
            <div class="skill-title">ULTIMATE</div>

            <div class="skill-meta">
                {
                    skills.ultimate.tags.length > 0 && (
                        <div class="skill-tags">
                            {skills.ultimate.tags.map((tagId) => (
                                <StyleTag id={tagId} />
                            ))}
                        </div>
                    )
                }

                <div class="skill-meta-line">
                    <span class="skill-meta-label"> Flame Cost </span>

                    <span class="skill-meta-value">
                        {skills.ultimate.flameCost}
                    </span>
                </div>
            </div>

            <div class="skill-divider"></div>

            <div class="skill-effects">
                {
                    skills.ultimate.effects.map((effect) => (
                        <SkillEffect effect={effect} />
                    ))
                }
            </div>

            <SkillModifiers
                awakeningEffects={ultimateAwakeningEffects}
                reconstructionEffects={ultimateReconstructionEffects}
            />
        </article>
    </div>
</div>
