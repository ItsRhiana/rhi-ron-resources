---
interface Props {
    effect: {
        text: string;
        multiplier?: number;
    };
}

const { effect } = Astro.props;

const hasMultiplier =
    effect.multiplier !== undefined &&
    effect.text.includes("{multiplier}");

const parts = hasMultiplier
    ? effect.text.split("{multiplier}")
    : null;
---

<p class="skill-effect">
    {
        parts ? (
            <>
                {parts[0]}

                <span class="multiplier">
                    {effect.multiplier}%
                </span>

                {parts[1]}
            </>
        ) : (
            effect.text
        )
    }
</p>

<style>
    .skill-effect {
        margin: 0;

        color: #dedbd3;

        font-size: 0.96rem;

        line-height: 1.5;
    }

    .multiplier {
        color: #d87945;

        font-weight: 700;
    }
</style>