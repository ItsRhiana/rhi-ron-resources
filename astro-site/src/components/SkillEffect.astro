---
import EffectText from "./EffectText.astro";

interface Props {
    effect: any;
}

const { effect } = Astro.props;

const values = {
    multiplier: effect.multiplier,
    ...effect.multipliers,
};
---

{
    effect.items ? (
        <div class="skill-effect-group">
            <div>
                {effect.intro}
            </div>

            <div class="skill-effect-list">
                {effect.items.map((item) => (
                    <div class="skill-effect-list-item">
                        <span class="skill-effect-marker">
                            •
                        </span>

                        <span>
                            <EffectText
                                text={item.description}
                                values={item.multipliers}
                            />
                        </span>
                    </div>
                ))}
            </div>

            <div>
                {effect.footer}
            </div>
        </div>
    ) : (
        <p class="skill-effect">
            <EffectText
                text={effect.description}
                values={values}
            />
        </p>
    )
}

<style>
    .skill-effect,
    .skill-effect-group {
        margin: 0;

        color: var(--color-text-description);

        font-family: var(--font-body);

        font-size: 1.14rem;
        font-weight: 400;

        line-height: 1.2;
    }

    .skill-effect-group,
    .skill-effect-list {
        display: flex;
        flex-direction: column;
    }

    .skill-effect-group {
        gap: 10px;
    }

    .skill-effect-list {
        gap: 8px;
    }

    .skill-effect-list-item {
        display: grid;

        grid-template-columns:
            14px minmax(0, 1fr);

        gap: 8px;

        align-items: start;
    }

    .skill-effect-marker {
        color: var(--color-text-muted);

        font-size: 0.6rem;

        line-height: 1.8;
    }
</style>