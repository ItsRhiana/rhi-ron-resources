---
import EffectText from "./EffectText.astro";

interface Props {
    effect: any;
}

const { effect } = Astro.props;

const values = {
    ...(effect.multiplier !== undefined
        ? {
            multiplier:
                effect.multiplier,
        }
        : {}),
    ...(effect.multipliers ?? {}),
};
---

<p class="skill-effect">
    <EffectText
        text={effect.description}
        values={values}
    />
</p>

<style>
    .skill-effect {
        margin: 0;

        color:
            var(--color-text-description);

        font-family:
            var(--font-body);

        font-size: 1.14rem;
        font-weight: 400;

        line-height: 1.2;
    }
</style>