---
interface Props {
    effect: {
        description: string;
        multiplier?: number;
        multipliers?: Record<string, number>;
    };
}

const { effect } = Astro.props;

const values: Record<string, number> = {
    ...(effect.multiplier !== undefined
        ? { multiplier: effect.multiplier }
        : {}),
    ...(effect.multipliers ?? {}),
};

/*
 * Split on both:
 * - multiplier placeholders: {m1}, {multiplier}, etc.
 * - line breaks
 */
const parts = effect.description.split(/(\{[^}]+\}|\n)/g);
---

<p class="skill-effect">
    {
        parts.map((part) => {
            if (part === "\n") {
                return <br />;
            }

            const match = part.match(/^\{([^}]+)\}$/);

            if (!match) {
                return part;
            }

            const key = match[1];
            const value = values[key];

            if (value === undefined) {
                return part;
            }

            return (
                <span class="multiplier">
                    {value}
                </span>
            );
        })
    }
</p>

<style>
    .skill-effect {
        margin: 0;

        color: #dedbd3;

        font-size: 0.96rem;
        line-height: 1.5;
    }

    .multiplier {
        color: #d87945;

        font-weight: 700;
    }
</style>