---
interface Props {
    effect: any;
}

const { effect } = Astro.props;

const values = {
    ...(effect.multiplier !== undefined
        ? { multiplier: effect.multiplier }
        : {}),
    ...(effect.multipliers ?? {}),
};

/*
 * Split on both:
 * - multiplier placeholders: {m1}, {multiplier}, etc.
 * - line breaks
 */
const parts = effect.description.split(/(\{[^}]+\}|\n)/g);
---

<p class="skill-effect">
    {
        parts.map((part) => {
            if (part === "\n") {
                return <br />;
            }

            const match =
                part.match(/^\{([^}%]+)(%)?\}$/);

            if (!match) {
                return part;
            }

            const key = match[1];
            const suffix = match[2] ?? "";

            return (
                <span class="multiplier">
                    {values[key]}
                    {suffix}
                </span>
            );
        })
    }
</p>

<style>
    .skill-effect {
        margin: 0;

        color: var(--color-text-description);

        font-family: var(--font-body);

        font-size: 1.14rem;
        font-weight: 400;

        line-height: 1.2;
    }

    .multiplier {
        color: var(--color-multiplier);
    }
</style>