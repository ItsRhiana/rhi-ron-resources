---
import StyleCard from "./StyleCard.astro";

import infiniteStairway from "../data/tier-lists/infinite-stairway";
import styles from "../data/styles";

const base = import.meta.env.BASE_URL;
---

<div class="tier-list">

  <!-- =====================================================
       Header
       ===================================================== -->

  <div class="tier-header">

    <div class="tier-corner"></div>

    {
      infiniteStairway.columns.map((column) => (
        <div class="tier-role">

          <img
            src={`${base}assets/icons/${column.icon}.webp`}
            alt=""
          />

          <span>
            {column.name}
          </span>

        </div>
      ))
    }

  </div>


  <!-- =====================================================
       Tiers
       ===================================================== -->

  {
    infiniteStairway.tiers.map((tier) => (
      <div class="tier-row">

        <div class="tier-rank">
          {tier.rank}
        </div>

        {
          infiniteStairway.columns.map((column) => {
            const styleIds =
              tier.cells[column.id];

            return (
              <div class="tier-cell">

                {styleIds.map((styleId) => {
                  const style = styles[styleId];

                  return (
                    <StyleCard
                      id={style.id}
                      characterName={style.characterName}
                      styleName={style.styleName}
                      rarity={style.rarity}
                      desire={style.desire}
                    />
                  );
                })}

              </div>
            );
          })
        }

      </div>
    ))
  }

</div>


<style>

  /* =====================================================
     Tier list
     ===================================================== */

  .tier-list {
    width: 100%;

    overflow-x: auto;

    border:
      1px
      solid
      #3b3e45;

    background: #17191d;
  }


  /* =====================================================
     Shared grid
     ===================================================== */

  .tier-header,
  .tier-row {
    display: grid;

    grid-template-columns:
      60px
      repeat(
        5,
        minmax(150px, 1fr)
      );

    min-width: 810px;
  }


  /* =====================================================
     Header
     ===================================================== */

  .tier-header {
    background: #202329;

    border-bottom:
      1px
      solid
      #555860;
  }

  .tier-corner {
    border-right:
      1px
      solid
      #3b3e45;
  }

  .tier-role {
    display: flex;

    align-items: center;
    justify-content: center;

    gap: 7px;

    min-height: 48px;

    padding:
      8px
      10px;

    box-sizing: border-box;

    border-right:
      1px
      solid
      #3b3e45;

    color: #d7d4cc;

    font-size: 0.85rem;
    font-weight: 800;

    line-height: 1.1;

    text-align: center;
  }

  .tier-role:last-child {
    border-right: 0;
  }

  .tier-role img {
    width: 26px;
    height: 26px;

    max-width: none;

    display: block;

    margin: 0;

    object-fit: contain;
  }


  /* =====================================================
     Tier rows
     ===================================================== */

  .tier-row {
    border-bottom:
      1px
      solid
      #3b3e45;
  }

  .tier-row:last-child {
    border-bottom: 0;
  }


  /* =====================================================
     Rank
     ===================================================== */

  .tier-rank {
    display: flex;

    align-items: center;
    justify-content: center;

    min-height: 145px;

    padding: 10px;

    box-sizing: border-box;

    border-right:
      1px
      solid
      #3b3e45;

    color: #eee9df;

    font-size: 1.15rem;
    font-weight: 800;
  }


  /* =====================================================
     Cells
     ===================================================== */

  .tier-cell {
    display: flex;

    flex-wrap: wrap;

    align-content: flex-start;

    gap: 10px;

    min-width: 0;
    min-height: 145px;

    padding: 10px;

    box-sizing: border-box;

    border-right:
      1px
      solid
      #3b3e45;
  }

  .tier-cell:last-child {
    border-right: 0;
  }

</style>