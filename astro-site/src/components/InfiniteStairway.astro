---
import StyleCard from "./StyleCard.astro";

import infiniteStairway from "../data/tier-lists/infinite-stairway";
import styles from "../data/styles";

const base = import.meta.env.BASE_URL;

const columnCount = infiniteStairway.columns.length;
---

<div class="tier-list">

  <div
    class="tier-table"
    style={`--tier-column-count: ${columnCount}`}
  >

    <!-- =====================================================
         Column headers
         ===================================================== -->

    <div class="tier-header tier-label"></div>

    {
      infiniteStairway.columns.map((column) => (
        <div class="tier-header">

          <img
            src={`${base}assets/icons/${column.icon}.webp`}
            class="role-icon"
            alt=""
          />

          <span>
            {column.name}
          </span>

        </div>
      ))
    }


    <!-- =====================================================
         Tiers
         ===================================================== -->

    {
      infiniteStairway.tiers.map((tier) => (
        <>

          <div
            class:list={[
              "tier-rank",
              `tier-${tier.rank.toLowerCase()}`,
            ]}
          >
            {tier.rank}
          </div>

          {
            infiniteStairway.columns.map((column) => {
              const styleIds =
                tier.cells[column.id];

              return (
                <div class="tier-cell">

                  {styleIds.map((styleId) => {
                    const style = styles[styleId];

                    return (
                      <StyleCard
                        id={style.id}
                        characterName={style.characterName}
                        styleName={style.styleName}
                        rarity={style.rarity}
                        desire={style.desire}
                      />
                    );
                  })}

                </div>
              );
            })
          }

        </>
      ))
    }

  </div>

</div>


<style>

  /* =========================================================
     Tier List
     ========================================================= */

  .tier-list {
    width: max-content;

    margin: 0 !important;
    padding: 0 !important;

    overflow-x: auto;

    background: var(--color-bg);

    font-family: var(--font-body);
  }


  .tier-table {
    display: grid;

    grid-template-columns:
      70px
      repeat(
        var(--tier-column-count),
        minmax(155px, max-content)
      );

    /* Gap between role columns */
    column-gap: 14px;

    /* Tier rows remain connected vertically */
    row-gap: 0;

    width: max-content;

    margin: 0 !important;
    padding: 0 !important;

    background: var(--color-bg);
  }


  /* Kill Starlight markdown margins inside the grid */
  .tier-table > * {
    margin: 0 !important;
  }


  /* =========================================================
     Column headers
     ========================================================= */

  .tier-header {
    display: flex;

    align-items: center;
    justify-content: center;

    gap: 7px;

    padding:
      8px
      10px;

    box-sizing: border-box;

    background: var(--color-panel-bg-accent);

    border-bottom:
      2px
      solid
      var(--color-border-soft);

    color: var(--color-text-primary);

    font-family: var(--font-body);

    font-size: 1rem;
    font-weight: 500;

    line-height: 1.2;

    text-align: center;
  }


  .tier-label {
    background: var(--color-bg);
  }


  .role-icon {
    width: 28px;
    height: 28px;

    max-width: none;

    display: block;

    flex-shrink: 0;

    margin: 0;

    object-fit: contain;
  }


  /* =========================================================
     Tier labels
     ========================================================= */

  .tier-rank {
    display: flex;

    align-items: center;
    justify-content: center;

    min-height: 155px;

    box-sizing: border-box;

    color: var(--color-panel-bg);

    font-family: var(--font-display);

    font-size: 1.3rem;
    font-weight: 700;

    line-height: 1;

    text-transform: uppercase;
  }


  .tier-t0 {
    background: var(--color-tier-0);
  }


  .tier-t1 {
    background: var(--color-tier-1);
  }


  .tier-t2 {
    background: var(--color-tier-2);
  }


  .tier-t3 {
    background: var(--color-tier-3);
  }


  /* =========================================================
     Cells

     StyleCard = 125px wide.

     One-card cells remain at the normal minimum column width.

     Cells containing 2+ cards can expand to fit exactly
     two cards per row:
       125 + 125 + 14 gap + 30 padding = 294px

     Additional cards wrap onto the next line.
     ========================================================= */

  .tier-cell {
    display: flex;

    flex-wrap: wrap;

    align-items: center;
    align-content: center;
    justify-content: center;

    gap: 14px;

    min-width: 155px;
    max-width: 294px;

    min-height: 155px;

    padding: 15px;

    box-sizing: border-box;

    background: var(--color-panel-bg);
  }


  /* =========================================================
     Small screens

     Do not collapse a multi-card cell to one card per row.
     The table remains horizontally scrollable instead.

     125 + 125 + 14 gap + 20 padding = 284px
     ========================================================= */

  @media screen and (max-width: 900px) {

    .tier-table {
      min-width: max-content;
    }


    .tier-header {
      gap: 5px;

      padding:
        7px
        8px;

      font-size: 0.75rem;
    }


    .role-icon {
      width: 22px;
      height: 22px;
    }


    .tier-rank {
      min-height: 120px;

      font-size: 1rem;
    }


    .tier-cell {
      min-width: 155px;
      max-width: 284px;

      min-height: 120px;

      padding: 10px;

      gap: 14px;
    }

  }

</style>