---
import styles from "../data/styles";
import StyleCard from "./StyleCard.astro";

interface Props {
  analysis?: any[];
}

const { analysis = [] } = Astro.props;
---

<section class="style-analysis">
  {
    analysis.length > 0 ? (
      analysis.map((item) => {
        if (item.type === "paragraph") {
          const lines = item.text.split("\n");

          return (
            <p class="analysis-paragraph">
              {lines.map((line, index) => (
                <>
                  {line}
                  {index < lines.length - 1 && <br />}
                </>
              ))}
            </p>
          );
        }

        if (item.type === "styles") {
          return (
            <div class="analysis-styles">
              {item.styleIds.map((styleId) => {
                const style = styles[styleId];

                if (!style) return null;

                return (
                  <StyleCard
                    id={style.id}
                    characterName={style.characterName}
                    styleName={style.styleName}
                    rarity={style.rarity}
                    desire={style.desire}
                  />
                );
              })}
            </div>
          );
        }

        return null;
      })
    ) : (
      <div class="analysis-placeholder">Analysis coming soon.</div>
    )
  }
</section>

<style>
  .style-analysis {
    display: flex;
    flex-direction: column;

    gap: 24px;

    padding: 24px 0;

    font-family: var(--font-body);
  }

  .analysis-paragraph {
    margin: 0;

    color: var(--color-text-description);

    font-size: 1.08rem;
    line-height: 1.6;
  }

  .analysis-styles {
    display: flex;
    flex-wrap: wrap;

    gap: 14px;

    align-items: flex-start;
  }

  .analysis-placeholder {
    color: var(--color-text-description);
  }
</style>
