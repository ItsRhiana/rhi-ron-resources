---
import { Icon } from "astro-icon/components";

import stats from "../data/stats";
import reconstructionEffects from "../data/reconstruction";

interface Props {
    deepening: Array<{
        stat: keyof typeof stats;
        value: string;
    }>;

    reconstruction: Array<keyof typeof reconstructionEffects>;
}

const {
    deepening,
    reconstruction,
} = Astro.props;
---

<aside class="kit-reflection">

    <div class="section-heading">
        REFLECTION
    </div>


    <div class="reflection-grid">

        <!-- Deepening -->

        <div class="reflection-section">

            <div class="reflection-subheading">
                DEEPENING
            </div>

            <div class="deepening-list">

                {deepening.map((item) => {
                    const stat = stats[item.stat];

                    return (
                        <div class="deepening-row">

                            <span class="deepening-stat">

                                <Icon
                                    name={stat.icon}
                                    size="20"
                                />

                                {stat.name}

                            </span>

                            <strong>
                                {item.value}
                            </strong>

                        </div>
                    );
                })}

            </div>

        </div>


        <!-- Reconstruction -->

        <div class="reflection-section">

            <div class="reflection-subheading">
                RECONSTRUCTION
            </div>

            <div class="reconstruction-list">

                {reconstruction.map((effectId) => {
                    const effect =
                        reconstructionEffects[effectId];

                    return (
                        <div class="reconstruction-row">

                            <div
                                class:list={[
                                    "reconstruction-rank",
                                    `reconstruction-${effect.rank.toLowerCase()}`,
                                ]}
                            >
                                {effect.rank}
                            </div>

                            <div class="reconstruction-content">

                                <strong>
                                    {effect.name}
                                </strong>

                                <span>
                                    {effect.description}
                                </span>

                            </div>

                        </div>
                    );
                })}

            </div>

        </div>

    </div>

</aside>