---
import { Icon } from "astro-icon/components";
import EffectText from "./EffectText.astro";
import stats from "../data/stats";
import reconstructionEffects, {
    sortReconstruction,
} from "../data/reconstruction";
import ReconstructionEntry from "./ReconstructionEntry.astro";

interface Props {
    deepening: any[];
    reconstruction: any[];
}

const { deepening, reconstruction } = Astro.props;
---

<aside class="kit-reflection">
    <div class="section-heading">Reflection</div>

    <div class="reflection-grid">
        <!-- Deepening -->

        <div class="reflection-section">
            <div class="reflection-subheading">DEEPENING</div>

            <div class="deepening-list">
                {
                    deepening.map((item) => {
                        const stat = stats[item.stat];

                        return (
                            <div class="deepening-row">
                                <span class="deepening-stat">
                                    <Icon name={stat.icon} size="20" />

                                    {stat.deepeningName}
                                </span>

                                <strong>{item.value}</strong>
                            </div>
                        );
                    })
                }
            </div>
        </div>

        <!-- Reconstruction -->

        <div class="reflection-section">
            <div class="reflection-subheading">RECONSTRUCTION</div>

            <div class="reconstruction-list">
                {
                    sortReconstruction(reconstruction).map((effectId) => {
                        const effect = reconstructionEffects[effectId];

                        return <ReconstructionEntry effect={effect} />;
                    })
                }
            </div>
        </div>
    </div>
</aside>
