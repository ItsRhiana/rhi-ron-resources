---
import { Icon } from "astro-icon/components";
import stats from "../data/stats";
import reconstructionEffects, {
    sortReconstruction,
} from "../data/reconstruction";
import ReconstructionEntry from "./ReconstructionEntry.astro";

interface Props {
    deepening: any[];
    reconstruction: any[];
}

const { deepening, reconstruction } = Astro.props;
---

<aside class="kit-reflection">
    <div class="section-heading">Reflection</div>

    <div class="reflection-grid">
        <!-- Deepening -->

        <div class="reflection-section">
            <div class="reflection-subheading">DEEPENING</div>

            <div class="deepening-list">
                {
                    deepening.map((item) => {
                        const stat = stats[item.stat];

                        return (
                            <div class="deepening-row">
                                <span class="deepening-stat">
                                    <Icon name={stat.icon} size="20" />

                                    {stat.deepeningName}
                                </span>

                                <strong>{item.value}</strong>
                            </div>
                        );
                    })
                }
            </div>
        </div>

        <!-- Reconstruction -->

        <div class="reflection-section">
            <div class="reflection-subheading">RECONSTRUCTION</div>

            <div class="reconstruction-list">
                {
                    sortReconstruction(reconstruction).map((effectId) => {
                        const effect = reconstructionEffects[effectId];

                        return <ReconstructionEntry effect={effect} />;
                    })
                }
            </div>
        </div>
    </div>
</aside>

<style>
    .kit-reflection {
        min-width: 0;

        margin: 0;
    }

    .reflection-grid {
        display: grid;

        grid-template-columns:
            var(--deepening-column-width)
            minmax(0, 1fr);

        gap: var(--kit-progression-gap);

        align-items: start;

        width: 100%;

        margin: 0;
    }

    .reflection-section {
        min-width: 0;

        margin: 0;

        border: 1px solid var(--color-border);

        background: var(--color-panel-bg);
    }

    .reflection-subheading {
        display: flex;

        align-items: center;

        height: 38px;

        margin: 0;

        padding: 0 16px;

        box-sizing: border-box;

        border-bottom: 1px solid var(--color-border);

        color: var(--color-text-primary);

        font-family: var(--font-display);

        font-size: 0.95rem;
        font-weight: 600;

        line-height: 1;

        letter-spacing: 0.02em;
    }

    .deepening-list {
        margin: 0;

        padding: 0 18px;
    }

    .deepening-row {
        display: grid;

        grid-template-columns: minmax(0, 1fr) auto;

        align-items: center;

        min-height: 72px;

        margin: 0;

        padding: 16px 0;

        column-gap: 12px;

        box-sizing: border-box;

        border-bottom: 1px solid var(--color-border-soft);
    }

    .deepening-row:last-child {
        border-bottom: 0;
    }

    .deepening-row span,
    .deepening-row strong {
        margin: 0;

        color: var(--color-text-primary);

        font-family: var(--font-body);

        font-size: 1.05rem;

        line-height: 1.2;

        white-space: nowrap;
    }

    .deepening-row span {
        font-weight: 500;
    }

    .deepening-row strong {
        justify-self: end;

        font-weight: 500;
    }

    .deepening-stat {
        display: inline-flex;

        align-items: center;

        gap: 8px;

        white-space: nowrap;
    }

    .deepening-stat svg {
        flex: 0 0 auto;

        color: var(--color-text-primary);
    }

    .reconstruction-list {
        margin: 0;

        padding: 0 18px;
    }

    @container (max-width: 1050px) {
        .reflection-grid {
            grid-template-columns:
                minmax(250px, 0.75fr)
                minmax(0, 1.25fr);
        }
    }

    @container (max-width: 700px) {
        .reflection-grid {
            grid-template-columns: 1fr;
        }
    }
</style>
