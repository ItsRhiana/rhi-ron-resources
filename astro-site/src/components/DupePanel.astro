---
interface Props {
    dupes: Array<{
        dupe: number;
        effects: Array<{
            text: string;
        }>;
    }>;
}

const { dupes } = Astro.props;

const roman = ["I", "II", "III", "IV", "V"];
---

<aside class="kit-dupes">

    <div class="section-heading">
        DUPES
    </div>

    <div class="dupe-list">

        {dupes.map((dupe) => (
            <div class="dupe-row">

                <div class="dupe-number">
                    {roman[dupe.dupe - 1]}
                </div>

                <div class="dupe-effects">

                    {dupe.effects.map((effect) => (
                        <div class="dupe-effect">
                            {effect.text}
                        </div>
                    ))}

                </div>

            </div>
        ))}

    </div>

</aside>