---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import { Icon } from "astro-icon/components";

import "../../styles/style-page.css";

import lodestar from "../../data/styles/lodestar-sea-rover";
import reconTraits from "../../data/recon-traits";
import stats from "../../data/stats";
import StyleTag from "../../components/StyleTag.astro";
import SkillEffect from "../../components/SkillEffect.astro";

const base = import.meta.env.BASE_URL;

const executionDupe = lodestar.kit.dupes.find((dupe) =>
    dupe.effects.some(
        (effect) =>
            "type" in effect &&
            effect.type === "actionFocus" &&
            effect.target === "execution",
    ),
);

const actionFocus = lodestar.kit.actionFocus;
const skills = lodestar.kit.skills;

const ultimateDupeEffects = lodestar.kit.dupes.flatMap((dupe) =>
    dupe.effects
        .filter(
            (effect) =>
                "type" in effect &&
                effect.type === "skill" &&
                effect.target === "ultimate",
        )
        .map((effect) => ({
            dupe: dupe.dupe,
            text: effect.text,
        })),
);
---

<StarlightPage
    frontmatter={{
        title: `${lodestar.character} — ${lodestar.style}`,
        description: `${lodestar.character} — ${lodestar.style} Style details.`,
        tableOfContents: false,
        prev: false,
        next: false,

        head: [
            {
                tag: "style",
                content: `
            :root {
                --sl-content-width: 100% !important;
            }

            .sl-markdown-content {
                max-width: none !important;
            }
        `,
            },
        ],
    }}
>
    <div class="style-page">
        <!-- ==================================================
             Header
             ================================================== -->

        <section class="style-header">
            <div class="style-header-inner">
                <!-- Art -->

                <div class="style-art-column">
                    <div class="style-art-frame">
                        <img
                            class="style-art"
                            src={`${base}assets/styles/${lodestar.id}.png`}
                            alt={`${lodestar.character} · ${lodestar.style}`}
                        />
                    </div>
                </div>

                <!-- Identity -->

                <div class="style-identity">
                    <div class="style-name-line">
                        <strong>{lodestar.character}</strong>

                        <span class="name-separator">·</span>

                        <span class="style-name">
                            {lodestar.style}
                        </span>
                    </div>

                    <div class="rarity">
                        {"★".repeat(lodestar.rarity)}
                    </div>

                    <div class="style-meta">
                        <span class="meta-item">
                            <img
                                src={`${base}assets/icons/${lodestar.desire}.webp`}
                                alt=""
                            />

                            Wrath
                        </span>

                        <span class="meta-item">
                            <img
                                src={`${base}assets/icons/${lodestar.class}.webp`}
                                alt=""
                            />

                            Annihilation
                        </span>
                    </div>

                    <div class="style-tags">
                        {
                            lodestar.kit.tags.map((tagId) => (
                                <StyleTag id={tagId} />
                            ))
                        }
                    </div>
                </div>

                <!-- Action Focus + Base Stats -->

                <div class="style-overview">
                    <div class="action-focus">
                        <div class="focus-item">
                            <span class="focus-name">INTEL</span>
                            <span class="focus-value">
                                ✦ {actionFocus.intel}
                            </span>
                        </div>

                        <div class="focus-item">
                            <span class="focus-name">SUPPLIES</span>
                            <span class="focus-value">
                                ✦ {actionFocus.supplies}
                            </span>
                        </div>

                        <div
                            class:list={[
                                "focus-item",
                                {
                                    modified: executionDupe,
                                },
                            ]}
                            title={executionDupe
                                ? "Dupe III — Execution Action Focus increased."
                                : undefined}
                        >
                            <span class="focus-name"> EXECUTION </span>

                            <span class="focus-value">
                                ✦ {actionFocus.execution}
                            </span>
                        </div>

                        <div class="focus-item">
                            <span class="focus-name">STRATEGY</span>
                            <span class="focus-value">
                                ✦ {actionFocus.strategy}
                            </span>
                        </div>
                    </div>

                    <div class="core-stats">
                        <div class="stats-heading">LV.100 BASE STATS</div>

                        {
                            (["hp", "atk", "def"] as const).map((statId) => {
                                const stat = stats[statId];
                                const value = lodestar.kit.stats[statId];

                                return (
                                    <div class="stat-row">
                                        <span class="stat-name">
                                            <Icon name={stat.icon} size="20" />

                                            {stat.name}
                                        </span>

                                        <strong>
                                            {value.toLocaleString("en-US")}
                                        </strong>
                                    </div>
                                );
                            })
                        }
                    </div>
                </div>
            </div>
        </section>

        <!-- ==================================================
             Tabs
             ================================================== -->

        <nav class="style-tabs">
            <button class="active" type="button"> KIT </button>

            <button type="button"> BUILD &amp; SYNERGIES </button>

            <button type="button"> REVIEW </button>
        </nav>

        <!-- ==================================================
             Kit
             ================================================== -->

        <section class="style-kit">
            <div class="kit-main-grid">
                <!-- ==================================================
             Skills
             ================================================== -->

                <div class="kit-skills">
                    <div class="section-heading">LV.10 SKILLS</div>

                    <div class="skills-grid">
                        <!-- BASIC -->

                        <article class="skill-column">
                            <div class="skill-title">BASIC</div>

                            <div class="skill-meta">
                                <div class="attack-meta">
                                    <span>
                                        Hit Count
                                        <strong>
                                            {skills.basic.attack.hitCount}
                                        </strong>
                                    </span>

                                    <span>
                                        Speed
                                        <strong>
                                            {skills.basic.attack.speed}
                                        </strong>
                                    </span>

                                    <span>
                                        Range
                                        <strong>
                                            {skills.basic.attack.range}
                                        </strong>
                                    </span>
                                </div>
                            </div>

                            <div class="skill-divider"></div>

                            <div class="skill-effects">
                                {
                                    skills.basic.effects.map((effect) => (
                                        <SkillEffect effect={effect} />
                                    ))
                                }
                            </div>
                        </article>

                        <!-- PASSIVE -->

                        <article class="skill-column">
                            <div class="skill-title">PASSIVE</div>

                            <div class="skill-meta">
                                {
                                    skills.passive.tags.length > 0 && (
                                        <div class="skill-tags">
                                            {skills.passive.tags.map(
                                                (tagId) => (
                                                    <StyleTag id={tagId} />
                                                ),
                                            )}
                                        </div>
                                    )
                                }

                                <div class="skill-meta-line">
                                    {skills.passive.trigger}
                                </div>
                            </div>

                            <div class="skill-divider"></div>

                            <div class="skill-effects">
                                {
                                    skills.passive.effects.map((effect) => (
                                        <SkillEffect effect={effect} />
                                    ))
                                }
                            </div>
                        </article>

                        <!-- ULTIMATE -->

                        <article class="skill-column">
                            <div class="skill-title">ULTIMATE</div>

                            <div class="skill-meta">
                                {
                                    skills.ultimate.tags.length > 0 && (
                                        <div class="skill-tags">
                                            {skills.ultimate.tags.map(
                                                (tagId) => (
                                                    <StyleTag id={tagId} />
                                                ),
                                            )}
                                        </div>
                                    )
                                }

                                <div class="skill-meta-line">
                                    Flame Cost {skills.ultimate.cost}
                                </div>
                            </div>

                            <div class="skill-divider"></div>

                            <div class="skill-effects">
                                {
                                    skills.ultimate.effects.map((effect) => (
                                        <SkillEffect effect={effect} />
                                    ))
                                }
                            </div>

                            {
                                ultimateDupeEffects.length > 0 && (
                                    <div class="skill-dupe-effects">
                                        {ultimateDupeEffects.map((effect) => (
                                            <div class="skill-dupe-effect">
                                                <span class="dupe-label">
                                                    DUPE{" "}
                                                    {
                                                        [
                                                            "I",
                                                            "II",
                                                            "III",
                                                            "IV",
                                                            "V",
                                                        ][effect.dupe - 1]
                                                    }
                                                </span>

                                                <span>{effect.text}</span>
                                            </div>
                                        ))}
                                    </div>
                                )
                            }
                        </article>
                    </div>
                </div>

                <!-- ==================================================
             Dupes
             ================================================== -->

                <aside class="kit-dupes">
                    <div class="section-heading">DUPES</div>

                    <div class="dupe-list">
                        {
                            lodestar.kit.dupes.map((dupe) => (
                                <div class="dupe-row">
                                    <div class="dupe-number">
                                        {
                                            ["I", "II", "III", "IV", "V"][
                                                dupe.dupe - 1
                                            ]
                                        }
                                    </div>

                                    <div class="dupe-effects">
                                        {dupe.effects.map((effect) => (
                                            <div class="dupe-effect">
                                                {effect.text}
                                            </div>
                                        ))}
                                    </div>
                                </div>
                            ))
                        }
                    </div>
                </aside>

                <!-- ==================================================
     Reconstruction
     ================================================== -->

                <aside class="kit-reconstruction">
                    <div class="section-heading">REFLECTION</div>

                    <div class="recon-grid">
                        <!-- Reflection -->

                        <div class="recon-subsection">
                            <div class="recon-subheading">DEEPENING</div>

                            <div class="reflection-list">
                                {
                                    lodestar.kit.reflection.map((item) => {
                                        const stat = stats[item.stat];

                                        return (
                                            <div class="reflection-row">
                                                <span class="deepening-stat">
                                                    <Icon
                                                        name={stat.icon}
                                                        size="20"
                                                    />

                                                    {stat.name}
                                                </span>

                                                <strong>{item.value}</strong>
                                            </div>
                                        );
                                    })
                                }
                            </div>
                        </div>

                        <!-- Traits -->

                        <div class="recon-subsection">
                            <div class="recon-subheading">RECONSTRUCTION</div>

                            <div class="trait-list">
                                {
                                    lodestar.kit.reconTraits.map((traitId) => {
                                        const trait = reconTraits[traitId];

                                        return (
                                            <div class="trait-row">
                                                <div
                                                    class:list={[
                                                        "trait-rank",
                                                        `trait-${trait.rank.toLowerCase()}`,
                                                    ]}
                                                >
                                                    {trait.rank}
                                                </div>

                                                <div class="trait-content">
                                                    <strong>
                                                        {trait.name}
                                                    </strong>

                                                    <span>{trait.effect}</span>
                                                </div>
                                            </div>
                                        );
                                    })
                                }
                            </div>
                        </div>
                    </div>
                </aside>
            </div>
        </section>
    </div>
</StarlightPage>

<style>
    /* ======================================================
       Page
       ====================================================== */

    .style-page {
        width: 100%;

        color: #e9e5dc;
    }

    /* ======================================================
       Remove Starlight prose spacing
       ====================================================== */

    :global(.sl-markdown-content .style-header *),
    :global(.sl-markdown-content .style-tabs *) {
        margin-top: 0 !important;
        margin-bottom: 0 !important;
    }
</style>