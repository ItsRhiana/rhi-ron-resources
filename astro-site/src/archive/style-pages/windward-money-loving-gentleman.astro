---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";

import "../../styles/fonts.css";
import "../../styles/colors.css";
import "../../styles/style-page.css";

import windward from "../../data/styles/windward-money-loving-gentleman";

import StyleHeader from "../../components/StyleHeader.astro";
import StyleKit from "../../components/StyleKit.astro";
---

<StarlightPage
    frontmatter={{
        title: `${windward.characterName} — ${windward.styleName}`,
        description: `${windward.characterName} — ${windward.styleName} Style details.`,
        tableOfContents: false,
        prev: false,
        next: false,

        head: [
            {
                tag: "style",
                content: `
                    :root {
                        --sl-content-width: 100% !important;
                    }

                    .sl-markdown-content {
                        max-width: none !important;
                    }
                `,
            },
        ],
    }}
>
    <div class="style-page">

        <StyleHeader style={windward} />

        <nav class="style-tabs">

            <button class="active" type="button">
                <span class="tab-label">
                    KIT
                </span>
            </button>

            <button type="button">
                <span class="tab-label">
                    BUILD &amp; SYNERGIES
                </span>
            </button>

            <button type="button">
                <span class="tab-label">
                    REVIEW
                </span>
            </button>

        </nav>

        <StyleKit style={windward} />

    </div>
</StarlightPage>